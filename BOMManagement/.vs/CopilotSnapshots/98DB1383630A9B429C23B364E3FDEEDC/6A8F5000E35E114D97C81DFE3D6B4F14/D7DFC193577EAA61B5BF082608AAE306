@page "/boms/tree/{Id:int}"
@rendermode InteractiveServer

@inject IBOMService BOMService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Ürün Reçete Ağacı - BOM Management</PageTitle>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/boms">Ürün Ağaçları</a></li>
            <li class="breadcrumb-item active">Reçete Ağacı</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="h3 mb-0">🌲 Ürün Reçete Ağacı (Çok Seviyeli BOM)</h1>
        <a href="/boms" class="btn btn-outline-secondary btn-sm">
            ← Reçete Listesine Dön
        </a>
    </div>
</div>

<LoadingSpinner IsLoading="_isLoading" Message="Reçete ağacı çözümleniyor..." />

@if (!_isLoading && _rootNode != null)
{
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Hedef Ürün:</span>
                        <h4 class="mb-0 fw-bold mt-1 text-primary">@_rootNode.ItemName</h4>
                        <div class="text-muted small mt-1 font-monospace">Kod: @_rootNode.ItemCode</div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-primary fs-6 py-2 px-3 border shadow-sm">
                            1.00 ADET
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4 small">
                        * Aşağıdaki ağaç, seçilen mamülün veya yarı mamülün altındaki tüm bileşenleri ve varsa alt yarı mamüllerin reçetelerini hiyerarşik olarak listeler. 
                        Toplam miktarlar fire oranları eklenerek hesaplanmıştır.
                    </p>

                    <div class="tree-container bg-light p-4 rounded border" style="max-height: 600px; overflow-y: auto;">
                        <ul class="list-group list-group-flush ms-0">
                            @RenderNode(_rootNode)
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BOMTreeNodeDto? _rootNode;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await BOMService.GetByIdAsync(Id);
            if (result.Success)
            {
                var treeResult = await BOMService.GetBOMTreeAsync(result.Data.ParentItemCode, 1);
                if (treeResult.Success)
                {
                    _rootNode = treeResult.Data;
                }
                else
                {
                    ToastService.ShowError(treeResult.Message);
                    Navigation.NavigateTo("/boms");
                }
            }
            else
            {
                ToastService.ShowError(result.Message);
                Navigation.NavigateTo("/boms");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Ağaç oluşturulurken hata oluştu: {ex.Message}");
            Navigation.NavigateTo("/boms");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private RenderFragment RenderNode(BOMTreeNodeDto node) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "li");
        // Custom styling for tree items
        builder.AddAttribute(seq++, "class", "list-group-item bg-transparent border-0 py-2 ps-4 position-relative tree-node-item");
        
        // Bullet Icon based on type
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "me-2");
        if (node.Children.Any())
        {
            builder.AddContent(seq++, "⚙️"); // Has sub-items -> Subassembly or Finished good
        }
        else
        {
            builder.AddContent(seq++, "📦"); // Leaf node -> Raw material
        }
        builder.CloseElement();

        // Main text
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "fw-medium");
        builder.AddContent(seq++, node.ItemName);
        builder.CloseElement();

        // Code badge
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "badge bg-white text-dark border ms-2 font-monospace");
        builder.AddContent(seq++, node.ItemCode);
        builder.CloseElement();

        // Type description
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "text-muted small ms-2 d-none d-md-inline");
        builder.AddContent(seq++, $"({node.ItemTypeDescription})");
        builder.CloseElement();

        // Target quantity float end
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "badge bg-white border text-primary font-monospace float-end fs-6 shadow-xs");
        builder.AddContent(seq++, $"{node.Quantity:N2} {node.Unit}");
        builder.CloseElement();

        // Recursive children rendering
        if (node.Children != null && node.Children.Any())
        {
            builder.OpenElement(seq++, "ul");
            builder.AddAttribute(seq++, "class", "list-group list-group-flush border-start ms-3 mt-2 ps-2");
            builder.AddAttribute(seq++, "style", "border-color: #dee2e6 !important;");
            foreach (var child in node.Children)
            {
                builder.AddContent(seq++, RenderNode(child));
            }
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
