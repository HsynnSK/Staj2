@inherits LayoutComponentBase

@inject BOMManagement.Services.ToastService ToastService

<div class="app-layout">

    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">

        <header class="app-topbar">
            <div class="topbar-left">
                <button class="topbar-toggle d-md-none" id="sidebarToggle" type="button">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="topbar-breadcrumb d-none d-md-flex align-items-center gap-2">
                    <i class="bi bi-house text-muted" style="font-size:.85rem;"></i>
                    <span class="text-muted" style="font-size:.75rem;">BOM Management</span>
                </div>
            </div>
            <div class="topbar-right">
                <div class="topbar-badge">
                    <i class="bi bi-bell"></i>
                    <span class="notif-dot"></span>
                </div>
                <div class="topbar-divider"></div>
                <div class="topbar-user">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <span class="user-name d-none d-lg-inline">Admin</span>
                </div>
            </div>
        </header>

        <main class="app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="blazor-error-boundary d-flex align-items-start gap-3 mt-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                        <div>
                            <h6 class="mb-1 fw-semibold">Beklenmeyen Bir Hata Oluştu</h6>
                            <p class="mb-2 small">@ex.Message</p>
                            <button class="btn btn-sm btn-outline-danger" @onclick="ResetError">
                                <i class="bi bi-arrow-clockwise me-1"></i>Sayfayı Yenile
                            </button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>

    </div>
</div>

<ToastNotification />

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss"><i class="bi bi-x"></i></span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private void ResetError()
    {
        _errorBoundary?.Recover();
    }
}
