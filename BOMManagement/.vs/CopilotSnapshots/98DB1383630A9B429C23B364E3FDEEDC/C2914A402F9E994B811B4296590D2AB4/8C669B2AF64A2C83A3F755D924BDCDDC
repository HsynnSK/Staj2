@page "/boms"
@rendermode InteractiveServer

@inject IBOMService BOMService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Ürün Ağaçları (BOM) - BOM Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Ürün Ağaçları (BOM)</h1>
        <p class="text-muted mb-0">Ürün reçetelerini ve operasyon rotalarını yönetin.</p>
    </div>
    <a href="/boms/create" class="btn btn-primary">
        <span class="me-1">➕</span> Yeni Ürün Ağacı
    </a>
</div>

<LoadingSpinner IsLoading="_isLoading" />

@if (!_isLoading)
{
    @* Arama ve Filtreleme *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0">
                    🔍
                </span>
                <input type="text" class="form-control border-start-0"
                       placeholder="BOM kodu veya mamül kodu/adı ile arayın..."
                       @bind="_searchTerm" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_searchTerm))
                {
                    <button class="btn btn-outline-secondary" @onclick="() => _searchTerm = string.Empty">
                        ✕
                    </button>
                }
            </div>
        </div>
    </div>

    @if (FilteredBOMs.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 150px;">BOM Kodu</th>
                            <th>Üretilecek Mamül / Yarı Mamül</th>
                            <th style="width: 100px;" class="text-center">Versiyon</th>
                            <th style="width: 150px;" class="text-end">Temel Miktar</th>
                            <th style="width: 120px;" class="text-center">Durum</th>
                            <th style="width: 150px;" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bom in FilteredBOMs)
                        {
                            <tr @onclick="() => NavigateToTree(bom.Id)" style="cursor: pointer;">
                                <td>
                                    <span class="fw-bold font-monospace text-primary">
                                        @bom.BOMCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        @bom.ParentItemName
                                    </div>
                                    <div class="text-muted small">Kod: @bom.ParentItemCode</div>
                                </td>
                                <td class="text-center font-monospace">v@bom.Version</td>
                                <td class="text-end font-monospace">@bom.BaseQuantity.ToString("N2") @GetUnitTypeDisplayName(bom.UnitCode)</td>
                                <td class="text-center" @onclick:stopPropagation>
                                    <button class="btn btn-sm @(bom.IsActive ? "btn-success" : "btn-outline-secondary")"
                                            @onclick="() => ToggleActive(bom)"
                                            title="@(bom.IsActive ? "Pasifleştir" : "Aktifleştir")">
                                        @(bom.IsActive ? "🟢 Aktif" : "⚪ Pasif")
                                    </button>
                                </td>
                                <td class="text-center" @onclick:stopPropagation>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/boms/edit/@bom.Id" class="btn btn-outline-primary" title="Düzenle">
                                            ✏️
                                        </a>
                                        <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(bom)" title="Sil">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-muted small">
                Toplam @FilteredBOMs.Count() / _boms.Count() kayıt gösteriliyor
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size: 3rem;">🌿</div>
            @if (!string.IsNullOrEmpty(_searchTerm))
            {
                <h5 class="text-muted">Arama sonucu bulunamadı</h5>
                <p class="text-muted">"<strong>@_searchTerm</strong>" aramasıyla eşleşen reçete yok.</p>
                <button class="btn btn-outline-primary" @onclick="() => _searchTerm = string.Empty">
                    Aramayı Temizle
                </button>
            }
            else
            {
                <h5 class="text-muted">Henüz ürün ağacı tanımlanmamış</h5>
                <p class="text-muted">İlk ürün ağacını (reçeteyi) ekleyerek başlayın.</p>
                <a href="/boms/create" class="btn btn-primary">
                    <span class="me-1">➕</span> Yeni Ürün Ağacı Ekle
                </a>
            }
        </div>
    }
}

<ConfirmationModal @ref="_confirmModal"
                   Title="Ürün Ağacı Silme"
                   Message="@_deleteMessage"
                   OnConfirm="ExecuteDelete" />

@code {
    private IEnumerable<BOMHeaderListDto> _boms = [];
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private ConfirmationModal? _confirmModal;
    private int _deleteBomId;
    private string _deleteMessage = string.Empty;

    private IEnumerable<BOMHeaderListDto> FilteredBOMs =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _boms
            : _boms.Where(b =>
                b.BOMCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                b.ParentItemCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                b.ParentItemName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadBOMsAsync();
    }

    private async Task LoadBOMsAsync()
    {
        _isLoading = true;
        try
        {
            var result = await BOMService.GetAllAsync();
            if (result.Success)
            {
                _boms = result.Data;
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Reçeteler yüklenirken hata oluştu: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleActive(BOMHeaderListDto bom)
    {
        try
        {
            var result = await BOMService.ToggleActiveStatusAsync(bom.Id);
            if (result.Success)
            {
                ToastService.ShowSuccess(result.Message);
                await LoadBOMsAsync(); // Reload to update states of other items (single active BOM rule)
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Durum güncellenirken hata oluştu: {ex.Message}");
        }
    }

    private void ConfirmDelete(BOMHeaderListDto bom)
    {
        _deleteBomId = bom.Id;
        _deleteMessage = $"'{bom.BOMCode}' kodlu reçeteyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.";
        _confirmModal?.Show();
    }

    private async Task ExecuteDelete()
    {
        try
        {
            var result = await BOMService.DeleteAsync(_deleteBomId);
            if (result.Success)
            {
                ToastService.ShowSuccess("Reçete başarıyla silindi.");
                await LoadBOMsAsync();
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Silme işlemi sırasında hata oluştu: {ex.Message}");
        }
    }

    private void NavigateToTree(int id)
    {
        NavigationManager.NavigateTo($"/boms/tree/{id}");
    }

    private static string GetUnitTypeDisplayName(UnitType unit) => unit switch
    {
        UnitType.Piece => "Adet",
        UnitType.Kg => "Kg",
        UnitType.Gram => "Gram",
        UnitType.Liter => "Litre",
        UnitType.Meter => "Metre",
        UnitType.SquareMeter => "m²",
        _ => unit.ToString()
    };
}
