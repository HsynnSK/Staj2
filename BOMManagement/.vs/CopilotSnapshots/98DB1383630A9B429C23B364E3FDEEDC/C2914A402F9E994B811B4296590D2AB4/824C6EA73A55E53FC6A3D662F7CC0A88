/* ============================================================
   BOM Management — Global Design System
   ============================================================ */

/* ---------- CSS Custom Properties ---------- */
:root {
    --bom-primary:        #4F46E5;
    --bom-primary-hover:  #4338CA;
    --bom-primary-light:  #EEF2FF;
    --bom-success:        #10B981;
    --bom-warning:        #F59E0B;
    --bom-danger:         #EF4444;
    --bom-info:           #06B6D4;

    --bom-sidebar-bg:     #0F172A;
    --bom-sidebar-width:  260px;

    --bom-bg:             #F1F5F9;
    --bom-surface:        #FFFFFF;
    --bom-border:         #E2E8F0;

    --bom-text-primary:   #0F172A;
    --bom-text-secondary: #64748B;
    --bom-text-muted:     #94A3B8;

    --bom-shadow-sm: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);
    --bom-shadow-md: 0 4px 6px -1px rgba(0,0,0,.07), 0 2px 4px -1px rgba(0,0,0,.04);
    --bom-shadow-lg: 0 10px 15px -3px rgba(0,0,0,.08), 0 4px 6px -2px rgba(0,0,0,.03);

    --bom-radius-sm: 6px;
    --bom-radius-md: 10px;
    --bom-radius-lg: 14px;

    --bom-transition: all .18s ease;
}

/* ---------- Base ---------- */
*, *::before, *::after { box-sizing: border-box; }

html, body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 14px;
    color: var(--bom-text-primary);
    background-color: var(--bom-bg);
    -webkit-font-smoothing: antialiased;
    height: 100%;
    margin: 0;
}

h1, h2, h3, h4, h5, h6 { font-weight: 600; color: var(--bom-text-primary); }

a { color: var(--bom-primary); }
a:hover { color: var(--bom-primary-hover); }

/* ---------- Buttons ---------- */
.btn {
    border-radius: var(--bom-radius-sm);
    font-weight: 500;
    font-size: .8125rem;
    letter-spacing: .01em;
    transition: var(--bom-transition);
}

.btn-primary {
    background-color: var(--bom-primary);
    border-color: var(--bom-primary);
}
.btn-primary:hover, .btn-primary:focus {
    background-color: var(--bom-primary-hover);
    border-color: var(--bom-primary-hover);
}
.btn-outline-primary { color: var(--bom-primary); border-color: var(--bom-primary); }
.btn-outline-primary:hover { background-color: var(--bom-primary); border-color: var(--bom-primary); }

.btn:focus, .btn:active:focus,
.form-control:focus, .form-select:focus, .form-check-input:focus {
    box-shadow: 0 0 0 .2rem rgba(79,70,229,.2);
}

/* ---------- Forms ---------- */
.form-control, .form-select {
    border-radius: var(--bom-radius-sm);
    border-color: var(--bom-border);
    font-size: .875rem;
    transition: var(--bom-transition);
}
.form-control:focus, .form-select:focus { border-color: var(--bom-primary); }
.form-label {
    font-size: .8125rem;
    font-weight: 500;
    color: var(--bom-text-secondary);
    margin-bottom: .35rem;
}

/* ---------- Cards ---------- */
.card {
    border: 1px solid var(--bom-border);
    border-radius: var(--bom-radius-md);
    box-shadow: var(--bom-shadow-sm);
    background-color: var(--bom-surface);
    transition: box-shadow .2s ease;
}
.card-header {
    background-color: transparent;
    border-bottom: 1px solid var(--bom-border);
    padding: 1rem 1.25rem;
    font-weight: 600;
}
.card-footer {
    background-color: #F8FAFC;
    border-top: 1px solid var(--bom-border);
}

/* ---------- Stat Cards ---------- */
.stat-card {
    border-radius: var(--bom-radius-lg);
    border: 1px solid var(--bom-border);
    box-shadow: var(--bom-shadow-sm);
    background: var(--bom-surface);
    transition: var(--bom-transition);
    overflow: hidden;
}
.stat-card:hover {
    box-shadow: var(--bom-shadow-md);
    transform: translateY(-2px);
}
.stat-card .stat-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--bom-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}
.stat-icon-primary { background: var(--bom-primary-light); color: var(--bom-primary); }
.stat-icon-success  { background: #ECFDF5; color: var(--bom-success); }
.stat-icon-warning  { background: #FFFBEB; color: var(--bom-warning); }
.stat-icon-info     { background: #ECFEFF; color: var(--bom-info); }

/* ---------- Tables ---------- */
.table { font-size: .875rem; border-color: var(--bom-border); }
.table thead th {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--bom-text-muted);
    font-weight: 600;
    border-bottom: 2px solid var(--bom-border);
    padding: .75rem 1rem;
    background-color: #F8FAFC;
}
.table tbody td { padding: .75rem 1rem; vertical-align: middle; }
.table-hover tbody tr:hover { background-color: rgba(79,70,229,.04); }

/* ---------- Badges ---------- */
.badge {
    font-weight: 500;
    font-size: .7rem;
    letter-spacing: .03em;
    border-radius: 20px;
    padding: .32em .75em;
}

/* ---------- Page Header ---------- */
.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: .75rem;
}
.page-header h1 { font-size: 1.4rem; margin-bottom: .15rem; }
.page-header .subtitle { font-size: .83rem; color: var(--bom-text-secondary); margin: 0; }

/* ---------- Toast ---------- */
.toast-success { border-left: 3px solid var(--bom-success); }
.toast-error   { border-left: 3px solid var(--bom-danger); }
.toast-warning { border-left: 3px solid var(--bom-warning); }
.toast-info    { border-left: 3px solid var(--bom-info); }

/* ---------- Validation ---------- */
.valid.modified:not([type=checkbox]) { outline: 1px solid var(--bom-success); }
.invalid { outline: 1px solid var(--bom-danger); }
.validation-message { color: var(--bom-danger); font-size: .8rem; margin-top: .25rem; }

/* ---------- Blazor Error ---------- */
.blazor-error-boundary {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-left: 4px solid var(--bom-danger);
    border-radius: var(--bom-radius-md);
    padding: 1rem 1.25rem;
    color: #991B1B;
}
.blazor-error-boundary::after { content: "Bir hata oluştu."; }

#blazor-error-ui {
    color-scheme: light only;
    background: #FFFBEB;
    bottom: 0; left: 0;
    box-shadow: 0 -1px 6px rgba(0,0,0,.1);
    box-sizing: border-box;
    display: none;
    padding: .6rem 1.25rem .7rem;
    position: fixed;
    width: 100%;
    z-index: 2000;
    font-size: .875rem;
}
#blazor-error-ui .dismiss { cursor: pointer; position: absolute; right: .75rem; top: .5rem; }

/* ---------- Tree View ---------- */
.tree-container ul { list-style-type: none; }
.tree-container .tree-node-item::before {
    content: "";
    position: absolute;
    top: 0; left: 8px;
    border-left: 1px dashed var(--bom-border);
    height: 100%;
}
.tree-container .tree-node-item:last-child::before { height: 18px; }
.tree-container .tree-node-item::after {
    content: "";
    position: absolute;
    top: 18px; left: 8px;
    border-top: 1px dashed var(--bom-border);
    width: 12px;
}

/* ---------- Utilities ---------- */
.font-monospace { font-family: 'Consolas', 'Courier New', monospace; }
.text-primary-custom { color: var(--bom-primary) !important; }
.bg-primary-light    { background-color: var(--bom-primary-light) !important; }
.darker-border-checkbox.form-check-input { border-color: #CBD5E1; }

.form-floating > .form-control-plaintext::placeholder,
.form-floating > .form-control::placeholder { color: var(--bom-text-muted); text-align: end; }
.form-floating > .form-control-plaintext:focus::placeholder,
.form-floating > .form-control:focus::placeholder { text-align: start; }
