/* ===== App Shell ===== */
.app-layout {
    display: flex;
    min-height: 100vh;
    background-color: var(--bom-bg);
}

/* ===== Sidebar ===== */
.app-sidebar {
    width: var(--bom-sidebar-width);
    flex-shrink: 0;
    background-color: var(--bom-sidebar-bg);
    height: 100vh;
    position: sticky;
    top: 0;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 100;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
}

/* ===== Main Area ===== */
.app-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

/* ===== Topbar ===== */
.app-topbar {
    height: 56px;
    background-color: var(--bom-surface);
    border-bottom: 1px solid var(--bom-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--bom-shadow-sm);
}

.topbar-left  { display: flex; align-items: center; gap: .75rem; }
.topbar-right { display: flex; align-items: center; gap: .5rem; }

.topbar-toggle {
    background: none;
    border: none;
    color: var(--bom-text-secondary);
    padding: .25rem .5rem;
    border-radius: var(--bom-radius-sm);
    cursor: pointer;
    transition: var(--bom-transition);
    line-height: 1;
}
.topbar-toggle:hover { background-color: var(--bom-bg); color: var(--bom-text-primary); }

.topbar-divider {
    width: 1px;
    height: 24px;
    background-color: var(--bom-border);
    margin: 0 .25rem;
}

.topbar-badge {
    position: relative;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--bom-radius-sm);
    color: var(--bom-text-secondary);
    cursor: pointer;
    transition: var(--bom-transition);
    font-size: 1rem;
}
.topbar-badge:hover { background-color: var(--bom-bg); color: var(--bom-text-primary); }
.notif-dot {
    position: absolute;
    top: 6px; right: 7px;
    width: 7px; height: 7px;
    background-color: var(--bom-danger);
    border-radius: 50%;
    border: 1.5px solid var(--bom-surface);
}

.topbar-user {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .25rem .5rem;
    border-radius: var(--bom-radius-sm);
    cursor: pointer;
    transition: var(--bom-transition);
}
.topbar-user:hover { background-color: var(--bom-bg); }
.user-avatar {
    width: 30px; height: 30px;
    background: linear-gradient(135deg, var(--bom-primary), #818CF8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: .85rem;
}
.user-name { font-size: .8125rem; font-weight: 500; color: var(--bom-text-primary); }

/* ===== Content Area ===== */
.app-content {
    flex: 1;
    padding: 1.75rem 2rem;
    overflow-y: auto;
}

/* ===== Mobile ===== */
@media (max-width: 767.98px) {
    .app-sidebar {
        position: fixed;
        left: -260px;
        transition: left .25s ease;
        z-index: 200;
    }
    .app-content {
        padding: 1.25rem 1rem;
    }
}
