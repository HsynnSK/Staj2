/* ===== Sidebar Brand ===== */
.sidebar-brand {
    display: flex;
    align-items: center;
    gap: .875rem;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
    text-decoration: none;
    margin-bottom: .5rem;
}

.brand-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #4F46E5, #818CF8);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.1rem;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(79,70,229,.4);
}

.brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
}
.brand-title {
    font-size: .9rem;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: .02em;
}
.brand-subtitle {
    font-size: .68rem;
    color: rgba(255,255,255,.35);
    font-weight: 400;
}

/* ===== Navigation ===== */
.sidebar-nav {
    padding: .5rem .75rem;
    flex: 1;
}

.nav-section { margin-bottom: .25rem; }

.nav-section-label {
    font-size: .65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: rgba(255,255,255,.3);
    padding: .75rem .625rem .4rem;
}

/* ===== Sidebar Links ===== */
.sidebar-link {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .6rem .75rem;
    border-radius: 8px;
    color: rgba(255,255,255,.6);
    text-decoration: none;
    font-size: .8375rem;
    font-weight: 450;
    transition: all .15s ease;
    margin-bottom: 2px;
    white-space: normal;
    overflow: visible;
    word-break: break-word;
    line-height: 1.35;
}

.sidebar-link:hover {
    background-color: rgba(255,255,255,.08);
    color: rgba(255,255,255,.9);
    text-decoration: none;
}

::deep .sidebar-link.active {
    background: linear-gradient(90deg, rgba(79,70,229,.35), rgba(79,70,229,.15));
    color: #A5B4FC;
    font-weight: 600;
    border-left: 3px solid #818CF8;
    padding-left: calc(.75rem - 3px);
}

.sidebar-icon {
    font-size: .95rem;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
    opacity: .75;
}

::deep .sidebar-link.active .sidebar-icon { opacity: 1; }
.sidebar-link:hover .sidebar-icon { opacity: 1; }

/* ===== Footer ===== */
.sidebar-footer {
    padding: .875rem 1.25rem;
    border-top: 1px solid rgba(255,255,255,.07);
    margin-top: auto;
}
.sidebar-footer-inner {
    font-size: .73rem;
    color: rgba(255,255,255,.3);
}
