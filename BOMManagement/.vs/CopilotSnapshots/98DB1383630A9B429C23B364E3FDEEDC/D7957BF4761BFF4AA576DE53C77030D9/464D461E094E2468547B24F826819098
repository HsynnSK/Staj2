@page "/"
@rendermode InteractiveServer

@inject IItemService ItemService
@inject IBOMService BOMService
@inject IWorkOrderService WorkOrderService
@inject ToastService ToastService

<PageTitle>Ana Sayfa - BOM Yönetim Sistemi</PageTitle>

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="subtitle">Sisteme genel bakış</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon stat-icon-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1" style="font-size:.8rem;">Toplam Malzeme</p>
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" style="color:var(--bom-primary);" role="status"></span>
                        }
                        else
                        {
                            <h2 class="fw-bold mb-0" style="font-size:1.75rem;">@_itemCount</h2>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer py-2 px-4">
                <a href="/items" class="text-decoration-none d-flex align-items-center gap-1" style="font-size:.8rem; font-weight:600; color:var(--bom-primary);">
                    Tüm Malzemeleri Gör <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon stat-icon-success">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1" style="font-size:.8rem;">Ürün Ağaçları (BOM)</p>
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                        }
                        else
                        {
                            <h2 class="fw-bold mb-0" style="font-size:1.75rem;">@_bomCount</h2>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer py-2 px-4">
                <a href="/boms" class="text-decoration-none d-flex align-items-center gap-1" style="font-size:.8rem; font-weight:600; color:var(--bom-success);">
                    Tüm Reçeteleri Gör <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon stat-icon-warning">
                        <i class="bi bi-clipboard2-check-fill"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1" style="font-size:.8rem;">Aktif Üretim Emirleri</p>
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
                        }
                        else
                        {
                            <h2 class="fw-bold mb-0" style="font-size:1.75rem;">@_workOrderCount</h2>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer py-2 px-4">
                <a href="/workorders" class="text-decoration-none d-flex align-items-center gap-1" style="font-size:.8rem; font-weight:600; color:var(--bom-warning);">
                    İş Emirlerini Yönet <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-lightning-charge-fill" style="color:var(--bom-primary);"></i>
        Hızlı İşlemler
    </div>
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2">
            <a href="/items/create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Yeni Malzeme
            </a>
            <a href="/boms/create" class="btn btn-outline-primary">
                <i class="bi bi-diagram-3 me-1"></i>Yeni BOM
            </a>
            <a href="/workorders/create" class="btn btn-outline-primary">
                <i class="bi bi-clipboard2-plus me-1"></i>Yeni Üretim Emri
            </a>
        </div>
    </div>
</div>

@code {
    private int _itemCount = 0;
    private int _bomCount = 0;
    private int _workOrderCount = 0;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var itemResult = await ItemService.GetAllAsync();
            if (itemResult.Success)
            {
                _itemCount = itemResult.Data.Count();
            }

            var bomResult = await BOMService.GetAllAsync();
            if (bomResult.Success)
            {
                _bomCount = bomResult.Data.Count();
            }

            var woResult = await WorkOrderService.GetAllAsync();
            if (woResult.Success)
            {
                _workOrderCount = woResult.Data.Count(w => w.Status == WorkOrderStatus.Released);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"İstatistikler yüklenirken hata oluştu: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
