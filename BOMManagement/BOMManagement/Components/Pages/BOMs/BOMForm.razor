@page "/boms/create"
@page "/boms/edit/{Id:int}"
@rendermode InteractiveServer

@inject IBOMService BOMService
@inject IItemService ItemService
@inject IWarehouseService WarehouseService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(_isEditMode ? "Ürün Ağacı Düzenle" : "Yeni Ürün Ağacı") - BOM Management</PageTitle>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/boms">Reçeteler</a></li>
            <li class="breadcrumb-item active">@(_isEditMode ? "Düzenle" : "Yeni")</li>
        </ol>
    </nav>
    <h1 class="h3">@(_isEditMode ? "Ürün Ağacı Düzenle" : "Yeni Ürün Ağacı Tanımla")</h1>
</div>

<LoadingSpinner IsLoading="_isLoading" Message="BOM verileri yükleniyor..." />

@if (!_isLoading)
{
    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" FormName="bomForm">
        <FluentValidationValidator />

        @* 1. GENEL BİLGİLER (HEADER) *@
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light border-0 py-3">
                <h5 class="card-title mb-0 fw-bold">📋 Genel Reçete Bilgileri</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    @* Ana Ürün (Parent Item) *@
                    <div class="col-md-6">
                        <label for="parentItem" class="form-label fw-medium">
                            Üretilecek Ürün (Mamül / Yarı Mamül) <span class="text-danger">*</span>
                        </label>
                        <InputSelect id="parentItem" class="form-select" @bind-Value="_model.ParentItemCode">
                            <option value="">-- Ürün Seçiniz --</option>
                            @foreach (var item in _parentItems)
                            {
                                <option value="@item.ItemCode">@item.ItemCode - @item.ItemName (@GetItemTypeDisplayName(item.ItemType))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.ParentItemCode" />
                    </div>

                    @* Reçete Kodu *@
                    <div class="col-md-6">
                        <label for="bomCode" class="form-label fw-medium">
                            Reçete / BOM Kodu <span class="text-danger">*</span>
                        </label>
                        <InputText id="bomCode" class="form-control" @bind-Value="_model.BOMCode" placeholder="Örn: BOM-LAPTOP-01" />
                        <ValidationMessage For="() => _model.BOMCode" />
                    </div>

                    @* Versiyon *@
                    <div class="col-md-3">
                        <label for="version" class="form-label fw-medium">Versiyon <span class="text-danger">*</span></label>
                        <InputNumber id="version" class="form-control" @bind-Value="_model.Version" />
                        <ValidationMessage For="() => _model.Version" />
                    </div>

                    @* Temel Miktar *@
                    <div class="col-md-3">
                        <label for="baseQty" class="form-label fw-medium">Temel Miktar <span class="text-danger">*</span></label>
                        <InputNumber id="baseQty" class="form-control" @bind-Value="_model.BaseQuantity" />
                        <ValidationMessage For="() => _model.BaseQuantity" />
                    </div>

                    @* Birim *@
                    <div class="col-md-3">
                        <label for="unitCode" class="form-label fw-medium">Birim <span class="text-danger">*</span></label>
                        <InputSelect id="unitCode" class="form-select" @bind-Value="_model.UnitCode">
                            @foreach (var unit in Enum.GetValues<UnitType>())
                            {
                                <option value="@unit">@GetUnitTypeDisplayName(unit)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.UnitCode" />
                    </div>

                    @* Aktif mi? *@
                    <div class="col-md-3 d-flex align-items-end pb-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input darker-border-checkbox" type="checkbox" id="isActive" @bind="_model.IsActive" />
                            <label class="form-check-label fw-medium ms-2" for="isActive">Varsayılan Aktif Reçete</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 2. REÇETE SATIRLARI (BOM LINES) *@
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">📦 Reçete Bileşenleri (Malzemeler)</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLine">
                    ➕ Bileşen Ekle
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width: 250px;">Bileşen Malzeme <span class="text-danger">*</span></th>
                                <th style="width: 130px;" class="text-end">Miktar <span class="text-danger">*</span></th>
                                <th style="width: 120px;">Birim</th>
                                <th style="width: 120px;" class="text-end">Fire Oranı (%)</th>
                                <th style="width: 200px;">Tüketim Deposu</th>
                                <th style="width: 80px;" class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_model.Lines.Any())
                            {
                                @for (int i = 0; i < _model.Lines.Count; i++)
                                {
                                    var index = i;
                                    var line = _model.Lines[index];
                                    <tr>
                                        <td>
                                            <select class="form-select form-select-sm" 
                                                    value="@line.ChildItemCode"
                                                    @onchange="(e) => OnChildItemChanged(line, e.Value?.ToString())">
                                                <option value="">-- Malzeme Seçiniz --</option>
                                                @foreach (var child in _allItems)
                                                {
                                                    <option value="@child.ItemCode">@child.ItemCode - @child.ItemName (@GetItemTypeDisplayName(child.ItemType))</option>
                                                }
                                            </select>
                                            <ValidationMessage For="() => line.ChildItemCode" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control form-control-sm text-end" @bind-Value="line.Quantity" />
                                            <ValidationMessage For="() => line.Quantity" />
                                        </td>
                                        <td>
                                            <InputSelect class="form-select form-select-sm" @bind-Value="line.UnitCode">
                                                @foreach (var unit in Enum.GetValues<UnitType>())
                                                {
                                                    <option value="@unit">@GetUnitTypeDisplayName(unit)</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="() => line.UnitCode" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control form-control-sm text-end" @bind-Value="line.ScrapRate" />
                                            <ValidationMessage For="() => line.ScrapRate" />
                                        </td>
                                        <td>
                                            <InputSelect class="form-select form-select-sm" @bind-Value="line.ConsumptionWarehouse" disabled>
                                                <option value="">-- Depo Seçiniz --</option>
                                                @foreach (var wh in _warehouses)
                                                {
                                                    <option value="@wh.WarehouseCode">@wh.WarehouseCode - @wh.WarehouseName</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="() => line.ConsumptionWarehouse" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(index)">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        Henüz bileşen eklenmemiş. Lütfen "Bileşen Ekle" butonu ile malzeme ekleyin.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* 3. ROTA / OPERASYON BİLGİLERİ (BOM ROUTES) *@
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">⚙️ Üretim Rotası (Operasyon Adımları)</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRoute">
                    ➕ Operasyon Ekle
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 90px;" class="text-center">Sıra No</th>
                                <th style="width: 180px;">İş İstasyonu</th>
                                <th>Operasyon Adı <span class="text-danger">*</span></th>
                                <th style="width: 140px;" class="text-end">Hazırlık Süresi (Dk)</th>
                                <th style="width: 140px;" class="text-end">Çalışma Süresi (Dk)</th>
                                <th style="width: 80px;" class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_model.Routes.Any())
                            {
                                @for (int i = 0; i < _model.Routes.Count; i++)
                                {
                                    var index = i;
                                    var route = _model.Routes[index];
                                    <tr>
                                        <td class="text-center">
                                            <InputNumber class="form-control form-control-sm text-center font-monospace" @bind-Value="route.OperationSeq" />
                                            <ValidationMessage For="() => route.OperationSeq" />
                                        </td>
                                        <td>
                                            <InputText class="form-control form-control-sm" @bind-Value="route.WorkCenterCode" placeholder="Örn: WS-01" />
                                            <ValidationMessage For="() => route.WorkCenterCode" />
                                        </td>
                                        <td>
                                            <InputText class="form-control form-control-sm" @bind-Value="route.OperationName" placeholder="Örn: Montaj / Kaynak" />
                                            <ValidationMessage For="() => route.OperationName" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control form-control-sm text-end" @bind-Value="route.SetupTime" />
                                            <ValidationMessage For="() => route.SetupTime" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control form-control-sm text-end" @bind-Value="route.RunTime" />
                                            <ValidationMessage For="() => route.RunTime" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRoute(index)">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        Reçeteye ait herhangi bir operasyon adımı (rota) girilmemiş. (İsteğe Bağlı)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* HATA BİLDİRİMİ *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mt-3 d-flex align-items-center" role="alert">
                <span class="me-2">❌</span>
                <div>@_errorMessage</div>
            </div>
        }

        @* FORM BUTONLARI *@
        <div class="d-flex justify-content-between mt-4 pb-5">
            <a href="/boms" class="btn btn-outline-secondary">
                ← İptal Et / Geri Dön
            </a>
            <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>💾 Reçeteyi Kaydet</span>
                }
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _isEditMode => Id > 0;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private BOMFormModel _model = new();
    private IEnumerable<ItemListDto> _allItems = [];
    private IEnumerable<ItemListDto> _parentItems = [];
    private IEnumerable<BOMManagement.Application.DTOs.Warehouse.WarehouseDto> _warehouses = [];

    protected override async Task OnInitializedAsync()
    {
        // Load items for selection dropdowns
        try
        {
            var itemResult = await ItemService.GetAllAsync();
            if (itemResult.Success)
            {
                _allItems = itemResult.Data;
                // Parent items must be Finished Goods or Sub-Assemblies
                _parentItems = _allItems.Where(i => i.ItemType == ItemType.FinishedGood || i.ItemType == ItemType.SubAssembly || i.ItemType == ItemType.Subcontracted);
            }

            var whResult = await WarehouseService.GetAllAsync();
            if (whResult.Success)
            {
                _warehouses = whResult.Data;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Seçenekler yüklenirken hata oluştu: {ex.Message}");
        }

        if (_isEditMode)
        {
            try
            {
                var result = await BOMService.GetByIdAsync(Id);
                if (result.Success)
                {
                    var detail = result.Data;
                    _model = new BOMFormModel
                    {
                        ParentItemCode = detail.ParentItemCode,
                        BOMCode = detail.BOMCode,
                        Version = detail.Version,
                        BaseQuantity = detail.BaseQuantity,
                        UnitCode = detail.UnitCode,
                        IsActive = detail.IsActive,
                        Lines = detail.Lines.Select(l => new BOMLineModel
                        {
                            ChildItemCode = l.ChildItemCode,
                            Quantity = l.Quantity,
                            UnitCode = l.UnitCode,
                            ScrapRate = l.ScrapRate,
                            ConsumptionWarehouse = l.ConsumptionWarehouse,
                            IsSubAssembly = l.IsSubAssembly
                        }).ToList(),
                        Routes = detail.Routes.Select(r => new BOMRouteModel
                        {
                            OperationSeq = r.OperationSeq,
                            WorkCenterCode = r.WorkCenterCode,
                            OperationName = r.OperationName,
                            SetupTime = r.SetupTime,
                            RunTime = r.RunTime
                        }).ToList()
                    };
                }
                else
                {
                    ToastService.ShowError(result.Message);
                    Navigation.NavigateTo("/boms");
                    return;
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Reçete detayları yüklenemedi: {ex.Message}");
                Navigation.NavigateTo("/boms");
                return;
            }
        }

        _isLoading = false;
    }

    private void AddLine()
    {
        _model.Lines.Add(new BOMLineModel());
    }

    private void OnChildItemChanged(BOMLineModel line, string? code)
    {
        line.ChildItemCode = code ?? string.Empty;
        if (!string.IsNullOrEmpty(code))
        {
            var selectedItem = _allItems.FirstOrDefault(i => i.ItemCode == code);
            if (selectedItem != null)
            {
                line.ConsumptionWarehouse = selectedItem.DefaultWarehouseCode;
                line.UnitCode = selectedItem.MainUnit;
            }
        }
        else
        {
            line.ConsumptionWarehouse = string.Empty;
        }
        StateHasChanged();
    }

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < _model.Lines.Count)
        {
            _model.Lines.RemoveAt(index);
        }
    }

    private void AddRoute()
    {
        // Auto increment seq number
        int nextSeq = (_model.Routes.Max(r => (int?)r.OperationSeq) ?? 0) + 10;
        _model.Routes.Add(new BOMRouteModel { OperationSeq = nextSeq });
    }

    private void RemoveRoute(int index)
    {
        if (index >= 0 && index < _model.Routes.Count)
        {
            _model.Routes.RemoveAt(index);
        }
    }

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            IResult result;

            if (_isEditMode)
            {
                var updateDto = new BOMHeaderUpdateDto
                {
                    Id = Id,
                    ParentItemCode = _model.ParentItemCode,
                    BOMCode = _model.BOMCode,
                    Version = _model.Version,
                    BaseQuantity = _model.BaseQuantity,
                    UnitCode = _model.UnitCode,
                    IsActive = _model.IsActive,
                    Lines = _model.Lines.Select(l => new BOMLineDto
                    {
                        ChildItemCode = l.ChildItemCode,
                        Quantity = l.Quantity,
                        UnitCode = l.UnitCode,
                        ScrapRate = l.ScrapRate,
                        ConsumptionWarehouse = l.ConsumptionWarehouse,
                        IsSubAssembly = _allItems.FirstOrDefault(x => x.ItemCode == l.ChildItemCode)?.ItemType == ItemType.SubAssembly ||
                                        _allItems.FirstOrDefault(x => x.ItemCode == l.ChildItemCode)?.ItemType == ItemType.Subcontracted
                    }).ToList(),
                    Routes = _model.Routes.Select(r => new BOMRouteDto
                    {
                        OperationSeq = r.OperationSeq,
                        WorkCenterCode = r.WorkCenterCode,
                        OperationName = r.OperationName,
                        SetupTime = r.SetupTime,
                        RunTime = r.RunTime
                    }).ToList()
                };
                result = await BOMService.UpdateAsync(updateDto);
            }
            else
            {
                var createDto = new BOMHeaderCreateDto
                {
                    ParentItemCode = _model.ParentItemCode,
                    BOMCode = _model.BOMCode,
                    Version = _model.Version,
                    BaseQuantity = _model.BaseQuantity,
                    UnitCode = _model.UnitCode,
                    IsActive = _model.IsActive,
                    Lines = _model.Lines.Select(l => new BOMLineDto
                    {
                        ChildItemCode = l.ChildItemCode,
                        Quantity = l.Quantity,
                        UnitCode = l.UnitCode,
                        ScrapRate = l.ScrapRate,
                        ConsumptionWarehouse = l.ConsumptionWarehouse,
                        IsSubAssembly = _allItems.FirstOrDefault(x => x.ItemCode == l.ChildItemCode)?.ItemType == ItemType.SubAssembly ||
                                        _allItems.FirstOrDefault(x => x.ItemCode == l.ChildItemCode)?.ItemType == ItemType.Subcontracted
                    }).ToList(),
                    Routes = _model.Routes.Select(r => new BOMRouteDto
                    {
                        OperationSeq = r.OperationSeq,
                        WorkCenterCode = r.WorkCenterCode,
                        OperationName = r.OperationName,
                        SetupTime = r.SetupTime,
                        RunTime = r.RunTime
                    }).ToList()
                };
                result = await BOMService.AddAsync(createDto);
            }

            if (result.Success)
            {
                ToastService.ShowSuccess(result.Message);
                Navigation.NavigateTo("/boms");
            }
            else
            {
                _errorMessage = result.Message;
                ToastService.ShowError(result.Message);
            }
        }
        catch (BOMManagement.Application.Common.Exceptions.BusinessException ex)
        {
            _errorMessage = ex.Message;
            ToastService.ShowError(ex.Message);
        }
        catch (BOMManagement.Application.Common.Exceptions.NotFoundException ex)
        {
            _errorMessage = ex.Message;
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Beklenmeyen bir hata oluştu: {ex.Message}";
            ToastService.ShowError(_errorMessage);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string GetItemTypeDisplayName(ItemType type) => type switch
    {
        ItemType.RawMaterial => "Hammadde",
        ItemType.SubAssembly => "Yarı Mamül",
        ItemType.FinishedGood => "Mamül",
        ItemType.Subcontracted => "Fason",
        _ => type.ToString()
    };

    private static string GetUnitTypeDisplayName(UnitType unit) => unit switch
    {
        UnitType.Piece => "Adet",
        UnitType.Kg => "Kg",
        UnitType.Gram => "Gram",
        UnitType.Liter => "Litre",
        UnitType.Meter => "Metre",
        UnitType.SquareMeter => "m²",
        _ => unit.ToString()
    };

    public class BOMFormModel
    {
        public string ParentItemCode { get; set; } = string.Empty;
        public string BOMCode { get; set; } = string.Empty;
        public int Version { get; set; } = 1;
        public decimal BaseQuantity { get; set; } = 1;
        public UnitType UnitCode { get; set; } = UnitType.Piece;
        public bool IsActive { get; set; } = true;

        public List<BOMLineModel> Lines { get; set; } = [];
        public List<BOMRouteModel> Routes { get; set; } = [];
    }

    public class BOMLineModel
    {
        public string ChildItemCode { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public UnitType UnitCode { get; set; } = UnitType.Piece;
        public decimal ScrapRate { get; set; } = 0;
        public string ConsumptionWarehouse { get; set; } = string.Empty;
        public bool IsSubAssembly { get; set; }
    }

    public class BOMRouteModel
    {
        public int OperationSeq { get; set; }
        public string WorkCenterCode { get; set; } = string.Empty;
        public string OperationName { get; set; } = string.Empty;
        public decimal SetupTime { get; set; } = 0;
        public decimal RunTime { get; set; } = 0;
    }
}
