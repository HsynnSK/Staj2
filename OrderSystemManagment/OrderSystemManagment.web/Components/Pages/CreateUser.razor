@page "/create-user"
@rendermode InteractiveServer
@attribute [Authorize]

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@using OrderSystemManagment.Domain.Entities.Module
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager

<PageTitle>Kullanıcı Ekle</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- User Creation Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3 fw-bold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-plus-fill me-2" viewBox="0 0 16 16">
                        <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                        <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5"/>
                    </svg>
                    Yeni Kullanıcı Ekle
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(_userSuccessMessage))
                    {
                        <div class="alert alert-success">@_userSuccessMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_userErrorMessage))
                    {
                        <div class="alert alert-danger">@_userErrorMessage</div>
                    }

                    <EditForm Model="@_userModel" OnValidSubmit="HandleUserSubmit" FormName="CreateUserForm">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="userName" class="form-label fw-semibold text-secondary small mb-1">Kullanıcı Adı</label>
                                <InputText id="userName" class="form-control" @bind-Value="_userModel.UserName" placeholder="Kullanıcı adı girin" />
                                <ValidationMessage For="@(() => _userModel.UserName)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label for="password" class="form-label fw-semibold text-secondary small mb-1">Şifre</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="_userModel.Password" placeholder="Şifre girin" />
                                <ValidationMessage For="@(() => _userModel.Password)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label for="roleSelect" class="form-label fw-semibold text-secondary small mb-1">Rol</label>
                                <InputSelect id="roleSelect" class="form-select" @bind-Value="_userModel.RoleId">
                                    <option value="0">-- Rol Seçin --</option>
                                    @foreach (var role in _roles)
                                    {
                                        <option value="@role.Id">@role.RoleName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _userModel.RoleId)" class="text-danger small" />
                            </div>

                            <div class="col-12 mt-4 pt-2">
                                <button type="submit" class="btn btn-primary px-4 fw-semibold w-100" disabled="@_isUserSaving">
                                    @if (_isUserSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Kullanıcıyı Kaydet
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Collapsible Role Creation Card (Placed Below) -->
            <div class="card shadow-sm border-0">
                <button type="button" class="card-header bg-dark text-white py-3 fw-bold border-0 text-start d-flex justify-content-between align-items-center w-100" @onclick="ToggleRolePanel" style="cursor: pointer; outline: none; border-radius: 0.375rem;">
                    <span class="d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-lock-fill me-2" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m0 5a1.5 1.5 0 0 1 .5 2.915V9a1.5 1.5 0 0 1-3 0V7.915A1.5 1.5 0 0 1 8 5"/>
                        </svg>
                        + Yeni Rol Ekle
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16" style="transition: transform 0.2s; transform: rotate(@(_isRolePanelExpanded ? "180deg" : "0deg"));">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
                
                @if (_isRolePanelExpanded)
                {
                    <div class="card-body p-4 border-top">
                        @if (!string.IsNullOrEmpty(_roleSuccessMessage))
                        {
                            <div class="alert alert-success">@_roleSuccessMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_roleErrorMessage))
                        {
                            <div class="alert alert-danger">@_roleErrorMessage</div>
                        }

                        <EditForm Model="@_roleModel" OnValidSubmit="HandleRoleSubmit" FormName="CreateRoleForm">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-12">
                                    <label for="roleName" class="form-label fw-semibold text-secondary small mb-1">Rol Adı</label>
                                    <InputText id="roleName" class="form-control" @bind-Value="_roleModel.RoleName" placeholder="Rol adını girin (Örn. Satış Temsilcisi)" />
                                    <ValidationMessage For="@(() => _roleModel.RoleName)" class="text-danger small" />
                                </div>

                                <!-- Order permissions module -->
                                <div class="col-md-6 mt-3">
                                    <div class="fw-bold text-primary border-bottom pb-1 mb-2 small text-uppercase" style="letter-spacing: 0.05em;">Sipariş Modülü Yetkileri</div>
                                    
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="orderCanRead" @bind="_roleModel.OrderCanRead">
                                        <label class="form-check-label fw-semibold text-secondary small" for="orderCanRead">Görüntüle (CanRead) - @(_roleModel.OrderCanRead ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="orderCanCreate" @bind="_roleModel.OrderCanCreate">
                                        <label class="form-check-label fw-semibold text-secondary small" for="orderCanCreate">Ekle (CanCreate) - @(_roleModel.OrderCanCreate ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="orderCanUpdate" @bind="_roleModel.OrderCanUpdate">
                                        <label class="form-check-label fw-semibold text-secondary small" for="orderCanUpdate">Güncelle (CanUpdate) - @(_roleModel.OrderCanUpdate ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="orderCanDelete" @bind="_roleModel.OrderCanDelete">
                                        <label class="form-check-label fw-semibold text-secondary small" for="orderCanDelete">Sil (CanDelete) - @(_roleModel.OrderCanDelete ? "1" : "0")</label>
                                    </div>
                                </div>

                                <!-- User permissions module -->
                                <div class="col-md-6 mt-3">
                                    <div class="fw-bold text-primary border-bottom pb-1 mb-2 small text-uppercase" style="letter-spacing: 0.05em;">Kullanıcı Modülü Yetkileri</div>
                                    
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="userCanRead" @bind="_roleModel.UserCanRead">
                                        <label class="form-check-label fw-semibold text-secondary small" for="userCanRead">Görüntüle (CanRead) - @(_roleModel.UserCanRead ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="userCanCreate" @bind="_roleModel.UserCanCreate">
                                        <label class="form-check-label fw-semibold text-secondary small" for="userCanCreate">Ekle (CanCreate) - @(_roleModel.UserCanCreate ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="userCanUpdate" @bind="_roleModel.UserCanUpdate">
                                        <label class="form-check-label fw-semibold text-secondary small" for="userCanUpdate">Güncelle (CanUpdate) - @(_roleModel.UserCanUpdate ? "1" : "0")</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="userCanDelete" @bind="_roleModel.UserCanDelete">
                                        <label class="form-check-label fw-semibold text-secondary small" for="userCanDelete">Sil (CanDelete) - @(_roleModel.UserCanDelete ? "1" : "0")</label>
                                    </div>
                                </div>

                                <div class="col-12 mt-4 pt-2">
                                    <button type="submit" class="btn btn-dark px-4 fw-semibold w-100" disabled="@_isRoleSaving">
                                        @if (_isRoleSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        Rolü Kaydet
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private CreateUserModel _userModel = new();
    private CreateRoleModel _roleModel = new();
    private List<Role> _roles = new();
    
    private bool _isUserSaving = false;
    private bool _isRoleSaving = false;
    private bool _isRolePanelExpanded = false;
    
    private string? _userSuccessMessage;
    private string? _userErrorMessage;
    
    private string? _roleSuccessMessage;
    private string? _roleErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private void ToggleRolePanel()
    {
        _isRolePanelExpanded = !_isRolePanelExpanded;
    }

    private async Task LoadRolesAsync()
    {
        _roles = (await UserRepository.GetRolesAsync()).ToList();
    }

    private async Task HandleUserSubmit()
    {
        _userSuccessMessage = null;
        _userErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_userModel.UserName) || string.IsNullOrWhiteSpace(_userModel.Password))
        {
            _userErrorMessage = "Kullanıcı adı ve şifre alanları zorunludur.";
            return;
        }

        if (_userModel.RoleId <= 0)
        {
            _userErrorMessage = "Lütfen bir rol seçin.";
            return;
        }

        _isUserSaving = true;

        try
        {
            var role = await UserRepository.GetRoleByIdAsync(_userModel.RoleId);
            if (role is null)
            {
                _userErrorMessage = "Seçilen rol bulunamadı.";
                return;
            }

            var user = new User
            {
                UserName = _userModel.UserName,
                Password = _userModel.Password,
                Role = role
            };

            await UserRepository.SaveUserAsync(user);
            _userSuccessMessage = $"\"{_userModel.UserName}\" kullanıcısı başarıyla oluşturuldu.";
            _userModel = new();
        }
        catch (Exception ex)
        {
            _userErrorMessage = $"Kullanıcı oluşturulurken hata: {ex.Message}";
        }
        finally
        {
            _isUserSaving = false;
        }
    }

    private async Task HandleRoleSubmit()
    {
        _roleSuccessMessage = null;
        _roleErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_roleModel.RoleName))
        {
            _roleErrorMessage = "Rol adı alanı zorunludur.";
            return;
        }

        _isRoleSaving = true;

        try
        {
            var newRole = new Role
            {
                RoleName = _roleModel.RoleName,
                OrderManagement = new ModulePermission
                {
                    CanRead = _roleModel.OrderCanRead,
                    CanCreate = _roleModel.OrderCanCreate,
                    CanUpdate = _roleModel.OrderCanUpdate,
                    CanDelete = _roleModel.OrderCanDelete
                },
                UserManagement = new ModulePermission
                {
                    CanRead = _roleModel.UserCanRead,
                    CanCreate = _roleModel.UserCanCreate,
                    CanUpdate = _roleModel.UserCanUpdate,
                    CanDelete = _roleModel.UserCanDelete
                }
            };

            await UserRepository.SaveRoleAsync(newRole);
            _roleSuccessMessage = $"\"{_roleModel.RoleName}\" rolü başarıyla oluşturuldu.";
            
            // Reload roles dropdown on the left side
            await LoadRolesAsync();
            
            _roleModel = new();
            _isRolePanelExpanded = false; // Collapse panel on success
        }
        catch (Exception ex)
        {
            _roleErrorMessage = $"Rol oluşturulurken hata: {ex.Message}";
        }
        finally
        {
            _isRoleSaving = false;
        }
    }

    public class CreateUserModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kullanıcı adı zorunludur.")]
        public string? UserName { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre zorunludur.")]
        public string? Password { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Lütfen bir rol seçin.")]
        public int RoleId { get; set; }
    }

    public class CreateRoleModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Rol adı zorunludur.")]
        public string? RoleName { get; set; }

        public bool OrderCanRead { get; set; }
        public bool OrderCanCreate { get; set; }
        public bool OrderCanUpdate { get; set; }
        public bool OrderCanDelete { get; set; }

        public bool UserCanRead { get; set; }
        public bool UserCanCreate { get; set; }
        public bool UserCanUpdate { get; set; }
        public bool UserCanDelete { get; set; }
    }
}