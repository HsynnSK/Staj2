@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using OrderSystemManagment.Domain.Interfaces
@using System.Security.Claims
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager

<PageTitle>Giriş Yap</PageTitle>

<div class="card border-0 shadow-lg" style="width: 400px; border-radius: 16px; overflow: hidden;">
    <div class="card-header border-0 text-white text-center p-4" style="background: linear-gradient(135deg, #0d6efd, #0a58ca);">
        <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle mb-3 shadow" style="width: 56px; height: 56px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
            </svg>
        </div>
        <h4 class="fw-bold mb-1">Order Management System</h4>
        <p class="text-white-50 small mb-0">Devam etmek için giriş yapın</p>
    </div>
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center py-2 small" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                </svg>
                @_errorMessage
            </div>
        }

        <form method="post" @formname="LoginForm" @onsubmit="HandleLogin">
            <AntiforgeryToken />
            <div class="mb-3">
                <label for="userName" class="form-label fw-semibold text-secondary small">Kullanıcı Adı</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#6c757d" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                        </svg>
                    </span>
                    <input type="text" id="userName" name="_userName" class="form-control" placeholder="Kullanıcı adınızı girin" @bind="_userName" required />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label fw-semibold text-secondary small">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#6c757d" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
                        </svg>
                    </span>
                    <input type="password" id="password" name="_password" class="form-control" placeholder="Şifrenizi girin" @bind="_password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold shadow-sm" style="border-radius: 8px; background: linear-gradient(135deg, #0d6efd, #0a58ca);">
                Giriş Yap
            </button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private string? _userName { get; set; }

    [SupplyParameterFromForm]
    private string? _password { get; set; }

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Kullanıcı adı ve şifre alanları boş bırakılamaz.";
            return;
        }

        var user = await UserRepository.GetUserByCredentialsAsync(_userName, _password);

        if (user is null)
        {
            _errorMessage = "Geçersiz kullanıcı adı veya şifre.";
            return;
        }

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new Claim(ClaimTypes.Name, user.UserName ?? ""),
            new Claim("RoleName", user.Role?.RoleName ?? ""),
        };

        // Order management permissions
        if (user.Role is not null)
        {
            user.Role.OrderManagement.IsUserAdmin(user.Role);
            user.Role.UserManagement.IsUserAdmin(user.Role);

            claims.Add(new Claim("OrderManagement.CanRead", user.Role.OrderManagement.CanRead.ToString()));
            claims.Add(new Claim("OrderManagement.CanCreate", user.Role.OrderManagement.CanCreate.ToString()));
            claims.Add(new Claim("OrderManagement.CanUpdate", user.Role.OrderManagement.CanUpdate.ToString()));
            claims.Add(new Claim("OrderManagement.CanDelete", user.Role.OrderManagement.CanDelete.ToString()));

            claims.Add(new Claim("UserManagement.CanRead", user.Role.UserManagement.CanRead.ToString()));
            claims.Add(new Claim("UserManagement.CanCreate", user.Role.UserManagement.CanCreate.ToString()));
            claims.Add(new Claim("UserManagement.CanUpdate", user.Role.UserManagement.CanUpdate.ToString()));
            claims.Add(new Claim("UserManagement.CanDelete", user.Role.UserManagement.CanDelete.ToString()));
        }

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        if (HttpContext is not null)
        {
            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        }

        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
