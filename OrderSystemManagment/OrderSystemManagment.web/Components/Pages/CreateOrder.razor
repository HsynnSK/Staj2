@page "/create-order"
@rendermode InteractiveServer
@attribute [Authorize]

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@inject ILookupRepository LookupRepository
@inject IOrderService OrderRepository
@inject ICurrencyService CurrencyService
@inject ILogger<CreateOrder> Logger

<PageTitle>Siparişi Oluştur</PageTitle>

<div class="container py-4">
	<h3 class="mb-4">Siparişi Oluştur</h3>

	<div class="card mb-4">
		<div class="card-header fw-bold">Sipariş Genel</div>
		<div class="card-body">
			<div class="row g-3">
				<div class="col-md-3">
					<label class="form-label">Cari</label>
					@if (!_customers.Any())
					{
						<select class="form-select" disabled>
							<option value="" disabled hidden>Cari seçiniz</option>
						</select>
					}
					else
					{
						<select class="form-select" value="@(_selectedCustomerCode ?? string.Empty)" disabled="@IsHeaderLocked" @onchange="HandleCustomerChanged">
							<option value="" disabled hidden>Cari seçiniz</option>
							@foreach (var customer in _customers)
							{
								<option value="@customer.Code">@customer.Name</option>
							}
						</select>
					}
				</div>

				<div class="col-md-3">
					<label class="form-label">Ödeme Tarihi</label>
					<InputDate class="form-control" @bind-Value="_paymentDate" disabled="@IsHeaderLocked" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Sipariş Para Birimi <span class="text-danger">*</span></label>
					<select class="form-select" value="@(_selectedCurrencyId?.ToString() ?? string.Empty)" disabled="@IsHeaderLocked" @onchange="HandleOrderCurrencyChanged">
						<option value="" disabled hidden>Para birimi seçiniz</option>
						@foreach (var currencyType in _currencyTypes)
						{
							<option value="@currencyType.Id">@currencyType.Name</option>
						}
					</select>
				</div>

				<div class="col-md-3">
					<label class="form-label">Toplam Tutar</label>
					<input class="form-control" value="@FormatGrandTotal(_order.Invoice?.GrandTotal, _selectedCurrencyId)" readonly />
				</div>
			</div>
			@if (_tcmbRateNotes.Count > 0)
			{
				<div class="mt-2 text-muted small">
					<div class="fw-bold mb-1"><span class="badge bg-light text-dark border">TCMB Döviz Çevrim Kurları</span></div>
					<ul class="list-unstyled mb-0 ps-2 border-start" style="border-width: 3px !important; border-color: #dee2e6 !important;">
						@foreach (var note in _tcmbRateNotes)
						{
							<li>• @note</li>
						}
					</ul>
				</div>
			}
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header fw-bold">Kalem Ekleme</div>
		<div class="card-body">
			<div class="row g-3 align-items-end">
				<div class="col-md-3">
					<label class="form-label">Stok Kodu</label>
					<select class="form-select" value="@_itemDraft.ItemCode" @onchange="HandleItemCodeChanged">
						<option value="" disabled hidden>Stok seçiniz</option>
						@foreach (var item in _items)
						{
							<option value="@item.Code">@item.Code - @item.Name</option>
						}
					</select>
				</div>

				<div class="col-md-3">
					<label class="form-label">Stok Adı</label>
					<input class="form-control" value="@_itemDraft.ItemName" readonly />
				</div>

				<div class="col-md-3">
					<label class="form-label">Grup Kodu</label>
					<input class="form-control" value="@_itemDraft.GroupCode" readonly />
				</div>

				<div class="col-md-3">
					<label class="form-label">Depo</label>
					@if (!_warehouses.Any())
					{
						<select class="form-select" disabled>
							<option value="">Depo kodu seçiniz</option>
						</select>
					}
					else
					{
						<select class="form-select" value="@(_selectedWarehouseId?.ToString() ?? string.Empty)" disabled="@(string.IsNullOrWhiteSpace(_itemDraft.ItemCode))" @onchange="OnWarehouseChanged">
							<option value="">Depo kodu seçiniz</option>
							@foreach (var warehouse in _warehouses)
							{
								@if (_itemDraft.ItemCode == string.Empty || _items.FirstOrDefault(x => x.Code == _itemDraft.ItemCode)?.Warehouse?.Id == warehouse.Id)
								{
									<option value="@warehouse.Id">@warehouse.Id - @warehouse.Name</option>
								}
							}
						</select>
					}
				</div>

				<div class="col-md-3">
					<label class="form-label">Döviz Tipi</label>
					<InputSelect class="form-select" @bind-Value="_itemDraft.CurrencyTypeId">
						<option value="0" disabled hidden>Döviz tipi seçiniz</option>
						@foreach (var currencyType in _currencyTypes)
						{
							<option value="@currencyType.Id">@currencyType.Name</option>
						}
					</InputSelect>
				</div>

				<div class="col-md-3">
					<label class="form-label">Ölçü Birimi</label>
					<InputText class="form-control" @bind-Value="_itemDraft.Unit" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Birim Fiyat</label>
					<InputNumber class="form-control" @bind-Value="_itemDraft.UnitPrice" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Miktar</label>
					<InputNumber class="form-control" @bind-Value="_itemDraft.Quantity" />
				</div>

				<div class="col-md-3 d-grid">
					<button type="button" class="btn btn-primary" @onclick="AddItemAsync">@(_editingOrderItemIndex.HasValue ? "Güncelle" : "Ekle")</button>
				</div>
			</div>
			@if (_editingOrderItemIndex.HasValue)
			{
				<div class="alert alert-warning mt-3 mb-0">Kalem düzenleniyor. Kaydetmek için güncelle butonunu kullanın.</div>
			}
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header fw-bold">Kalemler</div>
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-striped table-hover mb-0">
					<thead class="table-light">
						<tr>
							<th>Sıra</th>
							<th>Stok Kodu</th>
							<th>Stok Adı</th>
							<th>Grup Kodu</th>
							<th>Döviz Tipi</th>
							<th>Birim</th>
							<th>Depo</th>
							<th>Birim Fiyat</th>
							<th>Miktar</th>
							<th>Satır Tutarı</th>
							<th>İşlem</th>
						</tr>
					</thead>
					<tbody>
						@if (_orderItems.Count == 0)
						{
							<tr>
								<td colspan="12" class="text-center text-muted py-4">Henüz kalem eklenmedi.</td>
							</tr>
						}
						else
						{
							@for (var i = 0; i < _orderItems.Count; i++)
							{
								var itemIndex = i;
								var line = _orderItems[i];
								<tr>
									<td>@(i + 1)</td>
									<td>@(line.Item?.Code ?? string.Empty)</td>
									<td>@(line.Item?.Name ?? string.Empty)</td>
									<td>@(line.Item?.GroupCode ?? string.Empty)</td>
									<td>@(line.CurrencyType?.Name ?? string.Empty)</td>
									<td>@(line.Item?.UnitOfMeasure ?? line.Item?.Unit ?? string.Empty)</td>
									<td>@(line.Item?.Warehouse?.Name ?? string.Empty)</td>
									<td>@line.UnitPrice.ToString("N2")</td>
									<td>@line.Quantity</td>
									<td>@line.FormatLineTotal()</td>
									<td class="text-nowrap">
										<button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginEditOrderItem(itemIndex)">Düzenle</button>
										<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOrderItem(itemIndex)">Sil</button>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-end gap-2">
		<button type="button" class="btn btn-success" @onclick="CompleteOrderAsync" disabled="@(!_orderItems.Any() || !_paymentDate.HasValue)">
			Siparişi Tamamla
		</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(_message))
	{
		<div class="alert alert-info mt-3">@_message</div>
	}
</div>

@code {
	private Order _order = new()
	{
		Invoice = new Invoice()
	};

	private string? _selectedCustomerCode;
	private DateTime? _paymentDate;
	private int? _selectedWarehouseId;
	private int? _selectedCurrencyId;

	private readonly OrderItemDraft _itemDraft = new()
	{
		Quantity = 1
	};

	private readonly List<OrderItem> _orderItems = new();
	private List<Customer> _customers = new();
	private List<CurrencyType> _currencyTypes = new();
	private List<Item> _items = new();
	private List<Warehouse> _warehouses = new();
	private string? _message;
	private List<string> _tcmbRateNotes = new();
	private int? _editingOrderItemIndex;
	private bool IsHeaderLocked => _orderItems.Count > 0;
	private bool _allowWarehouseSelection;

	protected override async Task OnInitializedAsync()
	{
		_customers = (await LookupRepository.GetCustomersAsync()).ToList();
		_currencyTypes = (await LookupRepository.GetCurrencyTypesAsync()).ToList();
		_items = (await LookupRepository.GetItemsAsync()).ToList();
		_warehouses = (await LookupRepository.GetWarehousesAsync()).ToList();
		await RecalculateTotalAmountAsync();
	}

	private void HandleItemCodeChanged(ChangeEventArgs args)
	{
		var itemCode = args.Value?.ToString() ?? string.Empty;
		_itemDraft.ItemCode = itemCode;

		var selectedItem = _items.FirstOrDefault(x => x.Code == itemCode);

		if (selectedItem is null)
		{
			_itemDraft.ItemName = string.Empty;
			_itemDraft.GroupCode = string.Empty;
			_itemDraft.Unit = string.Empty;
			_itemDraft.WarehouseName = string.Empty;
			_selectedWarehouseId = null;
			return;
		}

		_itemDraft.ItemName = selectedItem.Name;
		_itemDraft.GroupCode = selectedItem.GroupCode;
		_itemDraft.Unit = selectedItem.Unit;
		_itemDraft.WarehouseName = string.Empty;
		_selectedWarehouseId = null;
		_allowWarehouseSelection = selectedItem.Warehouse is not null;
		if (selectedItem.Warehouse is not null)
		{
			_selectedWarehouseId = selectedItem.Warehouse.Id;
			_itemDraft.WarehouseName = selectedItem.Warehouse.Name;
		}
	}

	private void OnWarehouseChanged(ChangeEventArgs args)
	{
		if (int.TryParse(args.Value?.ToString(), out var warehouseId))
		{
			_selectedWarehouseId = warehouseId;
			_itemDraft.WarehouseName = _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? string.Empty;
		}
		else
		{
			_selectedWarehouseId = null;
			_itemDraft.WarehouseName = "";
		}
	}

	private void HandleCustomerChanged(ChangeEventArgs args)
	{
		_selectedCustomerCode = args.Value?.ToString();
	}

	private async Task HandleOrderCurrencyChanged(ChangeEventArgs args)
	{
		if (int.TryParse(args.Value?.ToString(), out var currencyId))
		{
			_selectedCurrencyId = currencyId;
			var selectedCurrency = _currencyTypes.FirstOrDefault(x => x.Id == currencyId);
			_order.CurrencyType = selectedCurrency;
			if (_order.Invoice is not null)
			{
				_order.Invoice.CurrencyType = selectedCurrency;
			}
			await RecalculateTotalAmountAsync();
		}
		else
		{
			_selectedCurrencyId = null;
			_order.CurrencyType = null;
			if (_order.Invoice is not null)
			{
				_order.Invoice.CurrencyType = null;
			}
			await RecalculateTotalAmountAsync();
		}
	}

	private async Task AddItemAsync()
	{
		if (!_paymentDate.HasValue)
		{
			_message = "Lütfen önce ödeme tarihi seçiniz.";
			return;
		}

		if (_paymentDate.Value.Date < DateTime.Today)
		{
			_message = "Ödeme tarihi bugünden geri olamaz.";
			return;
		}

		if (string.IsNullOrWhiteSpace(_selectedCustomerCode))
		{
			_message = "Lütfen önce cari seçiniz.";
			return;
		}

		if (_selectedCurrencyId == null)
		{
			_message = "Lütfen önce üst bilgilerden \"Sipariş Para Birimi\" seçiniz. Seçim yapılmadan kalem eklenemez.";
			return;
		}

		if (string.IsNullOrWhiteSpace(_itemDraft.ItemCode))
		{
			_message = "Lütfen stok kodu seçiniz.";
			return;
		}

		if (_itemDraft.Quantity < 1)
		{
			_message = "Miktar en az 1 olmalıdır.";
			return;
		}

		if (_itemDraft.UnitPrice < 0)
		{
			_message = "Birim fiyat negatif olamaz.";
			return;
		}

		if (_itemDraft.CurrencyTypeId == 0)
		{
			_message = "Lütfen döviz tipi seçiniz.";
			return;
		}

		var currentCurrencyTypeId = _itemDraft.CurrencyTypeId;
		var selectedCurrencyType = _currencyTypes.FirstOrDefault(x => x.Id == currentCurrencyTypeId);
		var selectedItem = _items.FirstOrDefault(x => x.Code == _itemDraft.ItemCode);

		if (selectedCurrencyType is null)
		{
			_message = "Seçilen döviz tipi bulunamadı.";
			return;
		}

		if (selectedItem is null)
		{
			_message = "Seçilen stok bulunamadı.";
			return;
		}

		var draftOrderItem = new OrderItem
		{
			Item = selectedItem,
			CurrencyType = selectedCurrencyType,
			UnitPrice = _itemDraft.UnitPrice,
			Quantity = _itemDraft.Quantity
		};

		if (_editingOrderItemIndex is int editingIndex && editingIndex >= 0 && editingIndex < _orderItems.Count)
		{
			_orderItems[editingIndex] = draftOrderItem;
			_message = "Kalem güncellendi.";
		}
		else
		{
			_orderItems.Add(draftOrderItem);
			_message = "Kalem eklendi.";
		}

		await RecalculateTotalAmountAsync();

		ResetItemDraft(currentCurrencyTypeId);
	}

	private void BeginEditOrderItem(int index)
	{
		if (index < 0 || index >= _orderItems.Count)
		{
			return;
		}

		var orderItem = _orderItems[index];
		var item = orderItem.Item;
		var warehouse = item?.Warehouse;
		var currencyType = orderItem.CurrencyType;

		_itemDraft.ItemCode = item?.Code ?? string.Empty;
		_itemDraft.ItemName = item?.Name ?? string.Empty;
		_itemDraft.GroupCode = item?.GroupCode ?? string.Empty;
		_itemDraft.Unit = item?.Unit ?? string.Empty;
		_itemDraft.UnitPrice = orderItem.UnitPrice;
		_itemDraft.Quantity = orderItem.Quantity;
		_itemDraft.CurrencyTypeId = currencyType?.Id ?? 0;
		_itemDraft.WarehouseName = warehouse?.Name ?? string.Empty;
		_selectedWarehouseId = warehouse?.Id;
		_allowWarehouseSelection = true;
		_editingOrderItemIndex = index;
		_message = "Kalem düzenleme için yüklendi.";
	}

	private async Task DeleteOrderItem(int index)
	{
		if (index < 0 || index >= _orderItems.Count)
		{
			return;
		}

		_orderItems.RemoveAt(index);

		if (_editingOrderItemIndex == index)
		{
			ResetItemDraft();
		}
		else if (_editingOrderItemIndex is int editingIndex && editingIndex > index)
		{
			_editingOrderItemIndex = editingIndex - 1;
		}

		await RecalculateTotalAmountAsync();
		_message = "Kalem silindi.";
	}

	private async Task CompleteOrderAsync()
	{
		if (_orderItems.Count == 0)
		{
			_message = "Kaydedilecek kalem bulunmuyor.";
			return;
		}

		if (_paymentDate.HasValue && _paymentDate.Value.Date < DateTime.Today)
		{
			_message = "Ödeme tarihi bugünden geri olamaz.";
			return;
		}

		_order.OrderItems = _orderItems.ToList();
		_order.Customer = _customers.FirstOrDefault(x => x.Code == _selectedCustomerCode);
		if (_order.Customer is null)
		{
			_message = "Seçilen cari bulunamadı.";
			return;
		}

		_order.PaymentDate = _paymentDate ?? DateTime.Today;
		await RecalculateTotalAmountAsync();

		await OrderRepository.SaveOrderAsync(_order);

		_order = new Order
		{
			Invoice = new Invoice()
		};
		_selectedCustomerCode = null;
		_paymentDate = null;
		_selectedCurrencyId = null;
		_orderItems.Clear();
		_editingOrderItemIndex = null;
		_tcmbRateNotes.Clear();

		ResetItemDraft();

		_message = "Sipariş başarıyla kaydedildi.";
	}

	private async Task RecalculateTotalAmountAsync()
	{
		_tcmbRateNotes.Clear();
		if (_order.Invoice is not null && _selectedCurrencyId.HasValue)
		{
			var targetCurrency = _currencyTypes.FirstOrDefault(x => x.Id == _selectedCurrencyId)?.Name ?? "TRY";
			var items = _orderItems.Select(x => (x.UnitPrice * x.Quantity, x.CurrencyType?.Name ?? "TRY")).ToList();
			try
			{
				var (grandTotal, exchangeRate, rateDate) = await CurrencyService.ConvertAndGetRateAsync(items, targetCurrency);
				_order.Invoice.GrandTotal = grandTotal;

				var allForeignCurrencies = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

				var normalizedTarget = CurrencyService.NormalizeCurrencyCode(targetCurrency);
				if (!normalizedTarget.Equals("TRY", StringComparison.OrdinalIgnoreCase))
				{
					allForeignCurrencies.Add(targetCurrency);
				}

				foreach (var item in _orderItems)
				{
					if (item.CurrencyType is not null)
					{
						var normalizedItem = CurrencyService.NormalizeCurrencyCode(item.CurrencyType.Name);
						if (!normalizedItem.Equals("TRY", StringComparison.OrdinalIgnoreCase))
						{
							allForeignCurrencies.Add(item.CurrencyType.Name);
						}
					}
				}

				foreach (var currencyName in allForeignCurrencies)
				{
					var note = await CurrencyService.GetRateDisplayNoteAsync(currencyName);
					if (note is not null)
					{
						_tcmbRateNotes.Add(note);
					}
				}
			}
			catch (Exception ex)
			{
				Logger.LogError(ex, "Error occurred during currency conversion in CreateOrder.");
				_order.Invoice.GrandTotal = 0;
				_message = $"Kur dönüşümü hatası: {ex.Message}";
			}
		}
		else if (_order.Invoice is not null)
		{
			_order.Invoice.GrandTotal = 0;
		}
	}

	private string FormatGrandTotal(double? amount, int? currencyTypeId)
	{
		if (amount == null || amount == 0) return "0";
		var currencyName = _currencyTypes.FirstOrDefault(x => x.Id == currencyTypeId)?.Name ?? string.Empty;
		return ((decimal)amount.Value).FormatMoney(currencyName);
	}

	private void ResetItemDraft(int currencyTypeId = 0)
	{
		_itemDraft.ItemCode = string.Empty;
		_itemDraft.ItemName = string.Empty;
		_itemDraft.GroupCode = string.Empty;
		_itemDraft.Unit = string.Empty;
		_itemDraft.UnitPrice = 0;
		_itemDraft.Quantity = 1;
		_itemDraft.CurrencyTypeId = currencyTypeId;
		_itemDraft.WarehouseName = string.Empty;
		_selectedWarehouseId = null;
		_allowWarehouseSelection = false;
		_editingOrderItemIndex = null;
	}

	private sealed class OrderItemDraft
	{
		public string ItemCode { get; set; } = string.Empty;

		public string ItemName { get; set; } = string.Empty;

		public string GroupCode { get; set; } = string.Empty;

		public string WarehouseName { get; set; } = string.Empty;

		public string Unit { get; set; } = string.Empty;

		public int CurrencyTypeId { get; set; }

		public decimal UnitPrice { get; set; }

		public int Quantity { get; set; }
	}
}