@page "/orders"
@page "/orders/{SelectedOrderId:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@inject NavigationManager NavigationManager
@inject IOrderService OrderRepository
@inject ICurrencyService CurrencyService
@inject ILogger<Orders> Logger

<PageTitle>Siparişler</PageTitle>

<AuthorizeView>
	<Authorized>
		@if (context.User.HasClaim(c => c.Type == "OrderManagement.CanRead" && c.Value == "True"))
		{
			<div class="container py-4">
				<h3 class="mb-4">Siparişler</h3>

				@if (_orders.Count == 0)
				{
					<div class="alert alert-info">Henüz kayıtlı sipariş bulunmuyor.</div>
				}
				else
				{
					<div class="row g-4">
						<div class="col-lg-5">
							<div class="card h-100">
								<div class="card-header d-flex justify-content-between align-items-center fw-bold">
									<span>Sipariş Listesi</span>
									<button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="ToggleFilter" title="Filtrele">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-filter" viewBox="0 0 16 16">
											<path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5"/>
										</svg>
									</button>
								</div>
								<div class="card-body p-0">
									@if (_isFilterVisible)
									{
										<div class="p-3 bg-light border-bottom">
											<div class="row g-2">
												<div class="col-12">
													<label class="form-label fw-semibold text-secondary small mb-1">Sipariş No</label>
													<input type="text" class="form-control form-control-sm" placeholder="Sipariş No ile ara..." @bind="_searchOrderId" @bind:event="oninput" @bind:after="ApplyFilters" />
												</div>
												<div class="col-12">
													<label class="form-label fw-semibold text-secondary small mb-1">Cari Kod / İsim</label>
													<input type="text" class="form-control form-control-sm" placeholder="Cari adı veya kodu ile ara..." @bind="_searchCustomer" @bind:event="oninput" @bind:after="ApplyFilters" />
												</div>
												<div class="col-12">
													<label class="form-label fw-semibold text-secondary small mb-1">Fatura No</label>
													<input type="text" class="form-control form-control-sm" placeholder="Fatura No ile ara..." @bind="_searchInvoiceId" @bind:event="oninput" @bind:after="ApplyFilters" />
												</div>
												<div class="col-6">
													<label class="form-label fw-semibold text-secondary small mb-1">Fatura Tarihi</label>
													<input type="date" class="form-control form-control-sm" @bind="_startDate" @bind:after="ApplyFilters" />
												</div>
												<div class="col-6">
													<label class="form-label fw-semibold text-secondary small mb-1">Ödeme Tarihi</label>
													<input type="date" class="form-control form-control-sm" @bind="_endDate" @bind:after="ApplyFilters" />
												</div>
												<div class="col-12 d-flex gap-2 justify-content-end mt-3">
													<button type="button" class="btn btn-sm btn-outline-secondary w-50" @onclick="ClearFilters">Temizle</button>
													<button type="button" class="btn btn-sm btn-secondary w-50" @onclick="ToggleFilter">Kapat</button>
												</div>
											</div>
										</div>
									}

									@if (_filteredOrders.Count == 0)
									{
										<div class="p-4 text-center text-warning fw-semibold">Filtrelere uygun sipariş bulunamadı.</div>
									}
									else
									{
										<div class="table-responsive">
											<table class="table table-hover mb-0 align-middle">
												<thead class="table-light">
													<tr>
														<th>Sipariş</th>
														<th>Cari</th>
														<th>Tarih</th>
														<th>Toplam</th>
														<th></th>
													</tr>
												</thead>
												<tbody>
													@foreach (var order in _filteredOrders)
													{
														<tr class="@(ReferenceEquals(order, _selectedOrder) ? "table-primary" : string.Empty)" @onclick="() => SelectOrder(order)">
														<td>@order.Id</td>
														<td>@(order.Customer?.Name ?? string.Empty)</td>
														<td>@(order.Invoice is null ? string.Empty : order.Invoice.InvoiceDate.ToString("dd.MM.yyyy HH:mm"))</td>
														<td>@FormatGrandTotal(order.Invoice?.GrandTotal, order.CurrencyType?.Name)</td>
														<td class="text-end">
															<AuthorizeView>
																<Authorized Context="innerContext">
																	@if (innerContext.User.HasClaim(c => c.Type == "OrderManagement.CanUpdate" && c.Value == "True"))
																	{
																		<button type="button" class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true" @onclick="() => EditOrder(order.Id)">Düzenle</button>
																	}
																</Authorized>
															</AuthorizeView>
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
							</div>
						</div>
					</div>

					<div class="col-lg-7">
						@if (_selectedOrder is null)
						{
							<div class="alert alert-warning">Detay görmek için bir sipariş seçin.</div>
						}
						else
						{
							var selectedOrder = _selectedOrder;
							<div class="card mb-4">
								<div class="card-header d-flex justify-content-between align-items-center">
									<span class="fw-bold">Sipariş Detayı</span>
									<div class="btn-group btn-group-sm">
										<AuthorizeView>
											<Authorized Context="innerContext">
												@if (innerContext.User.HasClaim(c => c.Type == "OrderManagement.CanDelete" && c.Value == "True"))
												{
													<button type="button" class="btn btn-outline-danger" @onclick="() => DeleteOrder(selectedOrder.Id)">Sil</button>
												}
											</Authorized>
										</AuthorizeView>
									</div>
								</div>
								<div class="card-body">
									<div class="row g-3">
										<div class="col-md-4">
											<div class="text-muted small">Sipariş No</div>
											<div class="fw-semibold">@selectedOrder.Id</div>
										</div>
										<div class="col-md-4">
											<div class="text-muted small">Cari</div>
											<div class="fw-semibold">@(selectedOrder.Customer?.Name ?? string.Empty)</div>
										</div>
										<div class="col-md-4">
											<div class="text-muted small">Ödeme Tarihi</div>
											<div class="fw-semibold">@selectedOrder.PaymentDate.ToString("dd.MM.yyyy")</div>
										</div>
										<div class="col-md-4">
											<div class="text-muted small">Fatura No</div>
											<div class="fw-semibold">@(selectedOrder.Invoice?.InvoiceNumber ?? string.Empty)</div>
										</div>
										<div class="col-md-4">
											<div class="text-muted small">Fatura Tarihi</div>
											<div class="fw-semibold">@(selectedOrder.Invoice is null ? string.Empty : selectedOrder.Invoice.InvoiceDate.ToString("dd.MM.yyyy HH:mm"))</div>
										</div>
										<div class="col-md-4">
											<div class="text-muted small">Toplam Tutar</div>
											<div class="fw-semibold">@FormatGrandTotal(selectedOrder.Invoice?.GrandTotal, selectedOrder.CurrencyType?.Name)</div>
										</div>
									</div>
									@if (_tcmbRateNotes.Count > 0)
									{
										<div class="mt-3 text-muted small">
											<div class="fw-bold mb-1"><span class="badge bg-light text-dark border">TCMB Döviz Çevrim Kurları</span></div>
											<ul class="list-unstyled mb-0 ps-2 border-start" style="border-width: 3px !important; border-color: #dee2e6 !important;">
												@foreach (var note in _tcmbRateNotes)
												{
													<li>• @note</li>
												}
											</ul>
										</div>
									}
								</div>
							</div>

							<div class="card">
								<div class="card-header fw-bold">Sipariş Kalemleri</div>
								<div class="card-body p-0">
									<div class="table-responsive">
										<table class="table table-striped table-hover mb-0 align-middle">
											<thead class="table-light">
												<tr>
													<th>#</th>
													<th>Stok Kodu</th>
													<th>Stok Adı</th>
													<th>Grup</th>
													<th>Depo</th>
													<th>Döviz</th>
													<th>Birim</th>
													<th>Birim Fiyat</th>
													<th>Miktar</th>
													<th>Tutar</th>
												</tr>
											</thead>
											<tbody>
												@if (!selectedOrder.OrderItems.Any())
												{
													<tr>
														<td colspan="10" class="text-center text-muted py-4">Bu siparişe ait kalem bulunmuyor.</td>
													</tr>
												}
												else
												{
													@for (var i = 0; i < selectedOrder.OrderItems.Count; i++)
													{
														var line = selectedOrder.OrderItems.ElementAt(i);
														<tr>
															<td>@(i + 1)</td>
															<td>@(line.Item?.Code ?? string.Empty)</td>
															<td>@(line.Item?.Name ?? string.Empty)</td>
															<td>@(line.Item?.GroupCode ?? string.Empty)</td>
															<td>@(line.Item?.Warehouse?.Name ?? string.Empty)</td>
															<td>@(line.CurrencyType?.Name ?? string.Empty)</td>
															<td>@(line.Item?.UnitOfMeasure ?? line.Item?.Unit ?? string.Empty)</td>
															<td>@line.UnitPrice.ToString("N2")</td>
															<td>@line.Quantity</td>
															<td>@line.FormatLineTotal()</td>
														</tr>
													}
												}
											</tbody>
										</table>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="container py-5">
			<div class="alert alert-danger shadow-sm border-0 d-flex align-items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-octagon-fill" viewBox="0 0 16 16">
					<path d="M11.46.146A.5.5 0 0 0 11.107 0H4.893a.5.5 0 0 0-.353.146L.146 4.54A.5.5 0 0 0 0 4.893v6.214a.5.5 0 0 0 .146.353l4.394 4.394a.5.5 0 0 0 .353.146h6.214a.5.5 0 0 0 .353-.146l4.394-4.394a.5.5 0 0 0 .146-.353V4.893a.5.5 0 0 0-.146-.353zM8 4c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995A.905.905 0 0 1 8 4m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
				</svg>
				<span>Siparişleri görüntülemek için yetkiniz bulunmamaktadır.</span>
			</div>
		</div>
	}
</Authorized>
</AuthorizeView>

@code {
	[Parameter]
	public int? SelectedOrderId { get; set; }

	private List<Order> _orders = new();
	private List<Order> _filteredOrders = new();
	private Order? _selectedOrder;
	private List<string> _tcmbRateNotes = new();

	private string _searchOrderId = string.Empty;
	private string _searchCustomer = string.Empty;
	private string _searchInvoiceId = string.Empty;
	private DateTime? _startDate;
	private DateTime? _endDate;
	private bool _isFilterVisible = false;

	protected override async Task OnInitializedAsync()
	{
		await LoadAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		if (SelectedOrderId.HasValue)
		{
			var found = _orders.FirstOrDefault(o => o.Id == SelectedOrderId.Value);
			if (found != null)
			{
				await SelectOrder(found);
			}
		}
	}

	private async Task LoadAsync()
	{
		_orders = (await OrderRepository.GetOrdersAsync()).ToList();
		await ApplyFilters();
	}

	private void ToggleFilter()
	{
		_isFilterVisible = !_isFilterVisible;
	}

	private async Task ApplyFilters()
	{
		var query = _orders.AsEnumerable();

		if (!string.IsNullOrWhiteSpace(_searchOrderId))
		{
			query = query.Where(o => o.Id.ToString().Contains(_searchOrderId, StringComparison.OrdinalIgnoreCase));
		}

		if (!string.IsNullOrWhiteSpace(_searchCustomer))
		{
			query = query.Where(o => o.Customer != null && (
				o.Customer.Name.Contains(_searchCustomer, StringComparison.OrdinalIgnoreCase) ||
				o.Customer.Code.Contains(_searchCustomer, StringComparison.OrdinalIgnoreCase)
			));
		}

		if (!string.IsNullOrWhiteSpace(_searchInvoiceId))
		{
			query = query.Where(o => o.Invoice != null && o.Invoice.InvoiceNumber.Contains(_searchInvoiceId, StringComparison.OrdinalIgnoreCase));
		}

		if (_startDate.HasValue)
		{
			query = query.Where(o => o.Invoice != null && o.Invoice.InvoiceDate.Date == _startDate.Value.Date);
		}

		if (_endDate.HasValue)
		{
			query = query.Where(o => o.PaymentDate.Date == _endDate.Value.Date);
		}

		_filteredOrders = query.ToList();

		if (_selectedOrder != null && !_filteredOrders.Any(o => o.Id == _selectedOrder.Id))
		{
			await SelectOrder(_filteredOrders.FirstOrDefault());
		}
		else if (_selectedOrder == null)
		{
			await SelectOrder(_filteredOrders.FirstOrDefault());
		}
	}

	private async Task ClearFilters()
	{
		_searchOrderId = string.Empty;
		_searchCustomer = string.Empty;
		_searchInvoiceId = string.Empty;
		_startDate = null;
		_endDate = null;
		await ApplyFilters();
	}

	private async Task SelectOrder(Order? order)
	{
		_selectedOrder = order;
		_tcmbRateNotes.Clear();

		if (order is not null && order.Invoice is not null)
		{
			try
			{
				var targetCurrency = order.CurrencyType?.Name ?? "TRY";

				// Collect all unique non-TRY currencies from items AND the order-level target currency
				var allForeignCurrencies = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
				var normalizedTarget = CurrencyService.NormalizeCurrencyCode(targetCurrency);
				if (!normalizedTarget.Equals("TRY", StringComparison.OrdinalIgnoreCase))
				{
					allForeignCurrencies.Add(targetCurrency);
				}

				foreach (var item in order.OrderItems)
				{
					if (item.CurrencyType is not null)
					{
						var normalizedItem = CurrencyService.NormalizeCurrencyCode(item.CurrencyType.Name);
						if (!normalizedItem.Equals("TRY", StringComparison.OrdinalIgnoreCase))
						{
							allForeignCurrencies.Add(item.CurrencyType.Name);
						}
					}
				}

				DateTime? targetDate = null;
				if (!string.IsNullOrWhiteSpace(order.Invoice.ExchangeRateDate) &&
					DateTime.TryParseExact(order.Invoice.ExchangeRateDate, "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var resolvedDate))
				{
					targetDate = resolvedDate;
				}
				else
				{
					targetDate = order.Invoice.InvoiceDate;
				}

				foreach (var currencyName in allForeignCurrencies)
				{
					var code = CurrencyService.NormalizeCurrencyCode(currencyName);
					// For the order's own target currency, use the saved exchange rate if it was recorded
					if (string.Equals(code, normalizedTarget, StringComparison.OrdinalIgnoreCase)
						&& order.Invoice.ExchangeRate > 0
						&& order.Invoice.ExchangeRate != 1.0m)
					{
						var unit = string.Equals(code, "JPY", StringComparison.OrdinalIgnoreCase) ? 100 : 1;
						var unitDisplay = unit > 1 ? $"{unit:N0} {currencyName}" : $"1 {currencyName}";
						_tcmbRateNotes.Add($"{unitDisplay} = {order.Invoice.ExchangeRate:N4} TL (Kur Bülten Tarihi: {order.Invoice.ExchangeRateDate})");
					}
					else
					{
						var note = await CurrencyService.GetRateDisplayNoteAsync(currencyName, targetDate);
						if (note is not null)
						{
							_tcmbRateNotes.Add(note);
						}
					}
				}
			}
			catch (Exception ex)
			{
				Logger.LogError(ex, "Error occurred while fetching exchange rates in Orders details.");
			}
		}
	}

	private void EditOrder(int orderId)
	{
		NavigationManager.NavigateTo($"/edit-order/{orderId}");
	}

	private async Task DeleteOrder(int orderId)
	{
		await OrderRepository.SoftDeleteOrderAsync(orderId);
		await LoadAsync();
	}

	private string FormatGrandTotal(double? amount, string? currencyName)
	{
		if (amount == null || amount == 0) return "0";
		return ((decimal)amount.Value).FormatMoney(currencyName ?? string.Empty);
	}
}