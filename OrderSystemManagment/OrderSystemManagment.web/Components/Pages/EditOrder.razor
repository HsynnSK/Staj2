@page "/edit-order/{OrderId:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@inject ILookupRepository LookupRepository
@inject IOrderService OrderRepository
@inject NavigationManager NavigationManager
@inject ICurrencyService CurrencyService
@inject ILogger<EditOrder> Logger

<PageTitle>Sipariş Düzenle</PageTitle>

<div class="container py-4">
	<h3 class="mb-4">Sipariş Düzenle</h3>

	@if (_isLoading)
	{
		<div class="alert alert-info">Sipariş yükleniyor...</div>
	}
	else if (_editingOrder is null)
	{
		<div class="alert alert-warning">Sipariş bulunamadı.</div>
	}
	else
	{
		@if (!string.IsNullOrWhiteSpace(_message))
		{
			<div class="alert alert-info">@_message</div>
		}

		<div class="card mb-4">
			<div class="card-header fw-bold">Sipariş Bilgileri</div>
			<div class="card-body">
				<div class="row g-3">
					<div class="col-md-3">
						<label class="form-label">Cari</label>
						@if (!_customers.Any())
						{
							<select class="form-select" disabled>
								<option value="" disabled hidden>Cari seçiniz</option>
							</select>
						}
						else
						{
							<select class="form-select" value="@(_editableCustomerCode ?? string.Empty)" @onchange="HandleCustomerChanged">
								<option value="" disabled hidden>Cari seçiniz</option>
								@foreach (var customer in _customers)
								{
									<option value="@customer.Code">@customer.Name</option>
								}
							</select>
						}
					</div>

					<div class="col-md-3">
						<label class="form-label">Ödeme Tarihi</label>
						<InputDate class="form-control" @bind-Value="_editingOrder.PaymentDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
					</div>

					<div class="col-md-3">
						<label class="form-label">Sipariş Para Birimi <span class="text-danger">*</span></label>
						<select class="form-select" value="@(_selectedCurrencyId?.ToString() ?? string.Empty)" @onchange="HandleOrderCurrencyChanged">
							<option value="" disabled hidden>Para birimi seçiniz</option>
							@foreach (var currencyType in _currencyTypes)
							{
								<option value="@currencyType.Id">@currencyType.Name</option>
							}
						</select>
					</div>

					<div class="col-md-3">
						<label class="form-label">Toplam Tutar</label>
						<input type="text" class="form-control" value="@FormatGrandTotal(_editingOrder.Invoice?.GrandTotal, _selectedCurrencyId)" readonly />
					</div>
				</div>
				@if (_tcmbRateNotes.Count > 0)
				{
					<div class="mt-2 text-muted small">
						<div class="fw-bold mb-1"><span class="badge bg-light text-dark border">TCMB Döviz Çevrim Kurları</span></div>
						<ul class="list-unstyled mb-0 ps-2 border-start" style="border-width: 3px !important; border-color: #dee2e6 !important;">
							@foreach (var note in _tcmbRateNotes)
							{
								<li>• @note</li>
							}
						</ul>
					</div>
				}
			</div>
		</div>

		<div class="card mb-4">
			<div class="card-header fw-bold">Sipariş Kalemleri</div>
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-striped table-hover mb-0 align-middle">
						<thead class="table-light">
							<tr>
								<th>#</th>
								<th>Stok Kodu</th>
								<th>Stok Adı</th>
								<th>Grup</th>
								<th>Depo</th>
								<th>Döviz</th>
								<th>Birim</th>
								<th>Birim Fiyat</th>
								<th>Miktar</th>
								<th>Tutar</th>
								<th>İşlem</th>
							</tr>
						</thead>
						<tbody>
							@for (var i = 0; i < _rows.Count; i++)
							{
								var rowIndex = i;
								var row = _rows[i];
								<tr>
									<td>@(i + 1)</td>
									<td>
										<select class="form-select" value="@row.ItemCode" @onchange="args => HandleRowItemCodeChanged(rowIndex, args)">
										<option value="" disabled hidden>Stok seçiniz</option>
										@foreach (var item in _items)
										{
											<option value="@item.Code">@item.Code - @item.Name</option>
										}
									</select>
								</td>
								<td><input class="form-control" value="@row.ItemName" readonly /></td>
								<td><input class="form-control" value="@row.GroupCode" readonly /></td>
								<td><input class="form-control" value="@row.WarehouseName" readonly /></td>
								<td>
									<InputSelect class="form-select" @bind-Value="row.CurrencyTypeId" @bind-Value:after="RecalculateTotalAsync">
										<option value="0" disabled hidden>Döviz tipi seçiniz</option>
										@foreach (var currencyType in _currencyTypes)
										{
											<option value="@currencyType.Id">@currencyType.Name</option>
										}
									</InputSelect>
								</td>
								<td><InputText class="form-control" @bind-Value="row.Unit" /></td>
								<td><InputNumber class="form-control" @bind-Value="row.UnitPrice" @bind-Value:after="RecalculateTotalAsync" /></td>
								<td><InputNumber class="form-control" @bind-Value="row.Quantity" @bind-Value:after="RecalculateTotalAsync" /></td>
								<td>@FormatLineTotal(row)</td>
								<td class="text-nowrap">
									<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRow(rowIndex)">Kaldır</button>
								</td>
							</tr>
						}

						<tr class="table-secondary">
							<td>Yeni</td>
							<td>
								<select class="form-select" value="@_newRow.ItemCode" @onchange="HandleNewRowItemCodeChanged">
									<option value="" disabled hidden>Stok seçiniz</option>
									@foreach (var item in _items)
									{
										<option value="@item.Code">@item.Code - @item.Name</option>
									}
								</select>
							</td>
							<td><input class="form-control" value="@_newRow.ItemName" readonly /></td>
							<td><input class="form-control" value="@_newRow.GroupCode" readonly /></td>
							<td><input class="form-control" value="@_newRow.WarehouseName" readonly /></td>
							<td>
								<InputSelect class="form-select" @bind-Value="_newRow.CurrencyTypeId">
									<option value="0" disabled hidden>Döviz tipi seçiniz</option>
									@foreach (var currencyType in _currencyTypes)
									{
										<option value="@currencyType.Id">@currencyType.Name</option>
									}
								</InputSelect>
							</td>
							<td><InputText class="form-control" @bind-Value="_newRow.Unit" /></td>
							<td><InputNumber class="form-control" @bind-Value="_newRow.UnitPrice" /></td>
							<td><InputNumber class="form-control" @bind-Value="_newRow.Quantity" /></td>
							<td>@FormatLineTotal(_newRow)</td>
							<td class="text-nowrap">
								<button type="button" class="btn btn-sm btn-primary" @onclick="AddNewRow">Ekle</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-end gap-2">
		<button type="button" class="btn btn-secondary" @onclick="BackToOrders">İptal</button>
		<button type="button" class="btn btn-success" @onclick="SaveAsync" disabled="@(!_rows.Any())">Kaydet</button>
	</div>
}
</div>

@code {
	[Parameter]
	public int OrderId { get; set; }

	private Order? _editingOrder;
	private List<Customer> _customers = new();
	private List<CurrencyType> _currencyTypes = new();
	private List<Item> _items = new();
	private List<Warehouse> _warehouses = new();
	private List<OrderRowModel> _rows = new();
	private readonly OrderRowModel _newRow = new() { Quantity = 1 };
	private string? _editableCustomerCode;
	private int? _selectedCurrencyId;
	private bool _isLoading = true;
	private string? _message;
	private List<string> _tcmbRateNotes = new();

	protected override async Task OnInitializedAsync()
	{
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_isLoading = true;
		_customers = (await LookupRepository.GetCustomersAsync()).ToList();
		_currencyTypes = (await LookupRepository.GetCurrencyTypesAsync()).ToList();
		_items = (await LookupRepository.GetItemsAsync()).ToList();
		_warehouses = (await LookupRepository.GetWarehousesAsync()).ToList();

		var order = await OrderRepository.GetOrderByIdAsync(OrderId);
		_editingOrder = order is null ? null : CloneOrder(order);
		_rows = _editingOrder?.OrderItems.Select(CreateRowModel).ToList() ?? new List<OrderRowModel>();
		_editableCustomerCode = _editingOrder?.Customer?.Code;
		_selectedCurrencyId = _editingOrder?.CurrencyType?.Id;
		ResetNewRow();
		await RecalculateTotalAsync();
		_isLoading = false;
	}

	private void HandleCustomerChanged(ChangeEventArgs args)
	{
		_editableCustomerCode = args.Value?.ToString();
	}

	private async Task HandleRowItemCodeChanged(int rowIndex, ChangeEventArgs args)
	{
		if (rowIndex < 0 || rowIndex >= _rows.Count)
		{
			return;
		}

		UpdateRowFromItemCode(_rows[rowIndex], args.Value?.ToString() ?? string.Empty);
		await RecalculateTotalAsync();
	}

	private void HandleNewRowItemCodeChanged(ChangeEventArgs args)
	{
		UpdateRowFromItemCode(_newRow, args.Value?.ToString() ?? string.Empty);
	}

	private void UpdateRowFromItemCode(OrderRowModel row, string itemCode)
	{
		row.ItemCode = itemCode;
		var selectedItem = _items.FirstOrDefault(x => x.Code == itemCode);

		if (selectedItem is null)
		{
			row.ItemName = string.Empty;
			row.GroupCode = string.Empty;
			row.Unit = string.Empty;
			row.WarehouseName = string.Empty;
			return;
		}

		row.ItemName = selectedItem.Name;
		row.GroupCode = selectedItem.GroupCode;
		row.Unit = selectedItem.UnitOfMeasure ?? selectedItem.Unit;
		row.WarehouseName = selectedItem.Warehouse?.Name ?? string.Empty;
	}

	private async Task HandleOrderCurrencyChanged(ChangeEventArgs args)
	{
		if (int.TryParse(args.Value?.ToString(), out var currencyId))
		{
			_selectedCurrencyId = currencyId;
			var selectedCurrency = _currencyTypes.FirstOrDefault(x => x.Id == currencyId);
			if (_editingOrder is not null)
			{
				_editingOrder.CurrencyType = selectedCurrency;
				if (_editingOrder.Invoice is not null)
				{
					_editingOrder.Invoice.CurrencyType = selectedCurrency;
				}
			}
			await RecalculateTotalAsync();
		}
		else
		{
			_selectedCurrencyId = null;
			if (_editingOrder is not null)
			{
				_editingOrder.CurrencyType = null;
				if (_editingOrder.Invoice is not null)
				{
					_editingOrder.Invoice.CurrencyType = null;
				}
			}
			await RecalculateTotalAsync();
		}
	}

	private async Task AddNewRow()
	{
		if (_editingOrder is null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_editableCustomerCode))
		{
			_message = "Lütfen önce cari seçiniz.";
			return;
		}

		if (_editingOrder.PaymentDate == default)
		{
			_message = "Lütfen önce ödeme tarihi seçiniz.";
			return;
		}

		if (_editingOrder.PaymentDate.Date < DateTime.Today)
		{
			_message = "Ödeme tarihi bugünden geri olamaz.";
			return;
		}

		if (_selectedCurrencyId == null)
		{
			_message = "Lütfen önce üst bilgilerden \"Sipariş Para Birimi\" seçiniz. Seçim yapılmadan kalem eklenemez.";
			return;
		}

		if (string.IsNullOrWhiteSpace(_newRow.ItemCode))
		{
			_message = "Lütfen stok kodu seçiniz.";
			return;
		}

		if (_newRow.CurrencyTypeId == 0)
		{
			_message = "Lütfen döviz tipi seçiniz.";
			return;
		}

		if (_newRow.Quantity < 1)
		{
			_message = "Miktar en az 1 olmalıdır.";
			return;
		}

		if (_newRow.UnitPrice < 0)
		{
			_message = "Birim fiyat negatif olamaz.";
			return;
		}

		var selectedItem = _items.FirstOrDefault(x => x.Code == _newRow.ItemCode);
		var selectedCurrencyType = _currencyTypes.FirstOrDefault(x => x.Id == _newRow.CurrencyTypeId);

		if (selectedItem is null || selectedCurrencyType is null)
		{
			_message = "Seçilen kalem bilgileri bulunamadı.";
			return;
		}

		_rows.Add(new OrderRowModel
		{
			ItemCode = selectedItem.Code,
			ItemName = selectedItem.Name,
			GroupCode = selectedItem.GroupCode,
			Unit = selectedItem.Unit,
			WarehouseName = selectedItem.Warehouse?.Name ?? string.Empty,
			CurrencyTypeId = selectedCurrencyType.Id,
			UnitPrice = _newRow.UnitPrice,
			Quantity = _newRow.Quantity
		});

		ResetNewRow();
		await RecalculateTotalAsync();
		_message = "Kalem eklendi.";
	}

	private async Task RemoveRow(int index)
	{
		if (index < 0 || index >= _rows.Count)
		{
			return;
		}

		_rows.RemoveAt(index);
		await RecalculateTotalAsync();
		_message = "Kalem kaldırıldı.";
	}

	private async Task SaveAsync()
	{
		if (_editingOrder is null)
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(_editableCustomerCode))
		{
			_message = "Lütfen önce cari seçiniz.";
			return;
		}

		if (_editingOrder.PaymentDate == default)
		{
			_message = "Lütfen önce ödeme tarihi seçiniz.";
			return;
		}

		if (_editingOrder.PaymentDate.Date < DateTime.Today)
		{
			_message = "Ödeme tarihi bugünden geri olamaz.";
			return;
		}

		if (_selectedCurrencyId == null)
		{
			_message = "Lütfen önce üst bilgilerden \"Sipariş Para Birimi\" seçiniz. Seçim yapılmadan kalem eklenemez.";
			return;
		}

		if (!_rows.Any())
		{
			_message = "Kaydedilecek kalem bulunmuyor.";
			return;
		}

		_editingOrder.Customer = _customers.FirstOrDefault(x => x.Code == _editableCustomerCode);
		if (_editingOrder.Customer is null)
		{
			_message = "Seçilen cari bulunamadı.";
			return;
		}

		_editingOrder.CurrencyType = _currencyTypes.FirstOrDefault(x => x.Id == _selectedCurrencyId);
		_editingOrder.OrderItems = _rows.Select(ToOrderItem).ToList();
		await RecalculateTotalAsync();
		await OrderRepository.UpdateOrderAsync(_editingOrder);
		NavigationManager.NavigateTo("/orders");
	}

	private async Task RecalculateTotalAsync()
	{
		_tcmbRateNotes.Clear();
		if (_editingOrder?.Invoice is not null && _selectedCurrencyId.HasValue)
		{
			var targetCurrency = _currencyTypes.FirstOrDefault(x => x.Id == _selectedCurrencyId)?.Name ?? "TRY";
			var items = _rows.Select(x => (x.UnitPrice * x.Quantity, GetCurrencyName(x.CurrencyTypeId))).ToList();
			try
			{
				var (grandTotal, exchangeRate, rateDate) = await CurrencyService.ConvertAndGetRateAsync(items, targetCurrency, _editingOrder.Invoice.InvoiceDate);
				_editingOrder.Invoice.GrandTotal = grandTotal;

				// Collect all unique non-TRY currencies across order items AND the target currency
				var allForeignCurrencies = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

				var normalizedTarget = CurrencyService.NormalizeCurrencyCode(targetCurrency);
				if (!normalizedTarget.Equals("TRY", StringComparison.OrdinalIgnoreCase))
				{
					allForeignCurrencies.Add(targetCurrency);
				}

				foreach (var row in _rows)
				{
					var currencyName = GetCurrencyName(row.CurrencyTypeId);
					if (!string.IsNullOrWhiteSpace(currencyName))
					{
						var normalizedItem = CurrencyService.NormalizeCurrencyCode(currencyName);
						if (!normalizedItem.Equals("TRY", StringComparison.OrdinalIgnoreCase))
						{
							allForeignCurrencies.Add(currencyName);
						}
					}
				}

				foreach (var currencyName in allForeignCurrencies)
				{
					var note = await CurrencyService.GetRateDisplayNoteAsync(currencyName, _editingOrder.Invoice.InvoiceDate);
					if (note is not null)
					{
						_tcmbRateNotes.Add(note);
					}
				}
			}
			catch (Exception ex)
			{
				Logger.LogError(ex, "Error occurred during currency conversion in EditOrder.");
				_editingOrder.Invoice.GrandTotal = 0;
				_message = $"Kur dönüşümü hatası: {ex.Message}";
			}
		}
		else if (_editingOrder?.Invoice is not null)
		{
			_editingOrder.Invoice.GrandTotal = 0;
		}
	}

	private void BackToOrders()
	{
		NavigationManager.NavigateTo("/orders");
	}

	private void ResetNewRow()
	{
		_newRow.ItemCode = string.Empty;
		_newRow.ItemName = string.Empty;
		_newRow.GroupCode = string.Empty;
		_newRow.WarehouseName = string.Empty;
		_newRow.Unit = string.Empty;
		_newRow.CurrencyTypeId = 0;
		_newRow.UnitPrice = 0;
		_newRow.Quantity = 1;
	}

	private static Order CloneOrder(Order source)
	{
		return new Order
		{
			Id = source.Id,
			PaymentDate = source.PaymentDate,
			Customer = CloneCustomer(source.Customer),
			Invoice = CloneInvoice(source.Invoice),
			CurrencyType = CloneCurrencyType(source.CurrencyType),
			OrderItems = source.OrderItems.Select(CloneOrderItem).ToList()
		};
	}

	private static Customer? CloneCustomer(Customer? source)
	{
		return source is null ? null : new Customer { Id = source.Id, Code = source.Code, Name = source.Name };
	}

	private static Invoice? CloneInvoice(Invoice? source)
	{
		return source is null
			? null
			: new Invoice
			{
				Id = source.Id,
				InvoiceNumber = source.InvoiceNumber,
				InvoiceType = source.InvoiceType,
				InvoiceDate = source.InvoiceDate,
				GrandTotal = source.GrandTotal,
				ExchangeRate = source.ExchangeRate,
				ExchangeRateDate = source.ExchangeRateDate
			};
	}

	private static OrderItem CloneOrderItem(OrderItem source)
	{
		return new OrderItem
		{
			Id = source.Id,
			UnitPrice = source.UnitPrice,
			Quantity = source.Quantity,
			Item = CloneItem(source.Item),
			CurrencyType = CloneCurrencyType(source.CurrencyType)
		};
	}

	private static Item? CloneItem(Item? source)
	{
		return source is null
			? null
			: new Item
			{
				Id = source.Id,
				Code = source.Code,
				Name = source.Name,
				GroupCode = source.GroupCode,
				Unit = source.Unit,
				UnitOfMeasure = source.UnitOfMeasure,
				Warehouse = CloneWarehouse(source.Warehouse)
			};
	}

	private static Warehouse? CloneWarehouse(Warehouse? source)
	{
		return source is null ? null : new Warehouse { Id = source.Id, Name = source.Name };
	}

	private static CurrencyType? CloneCurrencyType(CurrencyType? source)
	{
		return source is null ? null : new CurrencyType { Id = source.Id, Name = source.Name };
	}

	private OrderItem ToOrderItem(OrderRowModel row)
	{
		var selectedItem = _items.FirstOrDefault(x => x.Code == row.ItemCode);
		var selectedCurrencyType = _currencyTypes.FirstOrDefault(x => x.Id == row.CurrencyTypeId);

		return new OrderItem
		{
			Item = selectedItem,
			CurrencyType = selectedCurrencyType,
			UnitPrice = row.UnitPrice,
			Quantity = row.Quantity
		};
	}

	private OrderRowModel CreateRowModel(OrderItem source)
	{
		return new OrderRowModel
		{
			ItemCode = source.Item?.Code ?? string.Empty,
			ItemName = source.Item?.Name ?? string.Empty,
			GroupCode = source.Item?.GroupCode ?? string.Empty,
			WarehouseName = source.Item?.Warehouse?.Name ?? string.Empty,
			Unit = source.Item?.UnitOfMeasure ?? source.Item?.Unit ?? string.Empty,
			CurrencyTypeId = source.CurrencyType?.Id ?? 0,
			UnitPrice = source.UnitPrice,
			Quantity = source.Quantity
		};
	}

	private string FormatGrandTotal(double? amount, int? currencyTypeId)
	{
		if (amount == null || amount == 0) return "0";
		var currencyName = _currencyTypes.FirstOrDefault(x => x.Id == currencyTypeId)?.Name ?? string.Empty;
		return ((decimal)amount.Value).FormatMoney(currencyName);
	}

	private string FormatLineTotal(OrderRowModel row)
	{
		return (row.UnitPrice * row.Quantity).FormatMoney(row.CurrencyTypeId == 0 ? string.Empty : GetCurrencyName(row.CurrencyTypeId));
	}

	private string GetCurrencyName(int currencyTypeId)
	{
		return _currencyTypes.FirstOrDefault(x => x.Id == currencyTypeId)?.Name ?? string.Empty;
	}

	private sealed class OrderRowModel
	{
		public string ItemCode { get; set; } = string.Empty;
		public string ItemName { get; set; } = string.Empty;
		public string GroupCode { get; set; } = string.Empty;
		public string WarehouseName { get; set; } = string.Empty;
		public string Unit { get; set; } = string.Empty;
		public int CurrencyTypeId { get; set; }
		public decimal UnitPrice { get; set; }
		public int Quantity { get; set; }
	}
}