using System.Collections.ObjectModel;

namespace OrderManagementSystem.Domain.Entities;

public class Order
{
    public int Id { get; set; }

    public string Seri { get; set; } = string.Empty;

    public int SubeKodu { get; set; }

    public string CustomerCode { get; set; } = string.Empty;

    public string FatirsNo { get; set; } = string.Empty;

    public DateTime OrderDate { get; set; }

    public DateTime DeliveryDate { get; set; }

    public int CurrencyTypeId { get; set; }

    public int FaturaTip { get; set; }

    public int Tipi { get; set; }

    public string Yedek { get; set; } = string.Empty;

    public DateTime PaymentDate { get; set; }

    public decimal TotalAmount { get; set; }

    public ICollection<OrderItem> OrderItems { get; set; } = new Collection<OrderItem>();
}