@page "/create-order"
@rendermode InteractiveServer

@using OrderManagementSystem.Domain.Entities
@using OrderManagementSystem.Domain.Interfaces
@inject ILookupRepository LookupRepository
@inject IOrderRepository OrderRepository

<PageTitle>Siparişi Oluştur</PageTitle>

<div class="container py-4">
	<h3 class="mb-4">Siparişi Oluştur</h3>

	<div class="card mb-4">
		<div class="card-header fw-bold">Sipariş Genel</div>
		<div class="card-body">
			<div class="row g-3">
				<div class="col-md-4">
					<label class="form-label">Cari</label>
					<InputSelect class="form-select" @bind-Value="_order.CustomerCode" disabled="@IsHeaderLocked">
						<option value="">Cari seçiniz</option>
						@foreach (var customer in _customers)
						{
							<option value="@customer.Code">@customer.Name</option>
						}
					</InputSelect>
				</div>

				<div class="col-md-4">
					<label class="form-label">Ödeme Tarihi</label>
					<InputDate class="form-control" @bind-Value="_order.PaymentDate" disabled="@IsHeaderLocked" />
				</div>

				<div class="col-md-4">
					<label class="form-label">Toplam Tutar</label>
					<InputNumber class="form-control" @bind-Value="_order.TotalAmount" readonly />
				</div>
			</div>
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header fw-bold">Kalem Ekleme</div>
		<div class="card-body">
			<div class="row g-3 align-items-end">
				<div class="col-md-3">
					<label class="form-label">Stok Kodu</label>
					<select class="form-select" value="@_itemForm.ItemCode" @onchange="HandleItemCodeChanged">
						<option value="">Stok seçiniz</option>
						@foreach (var item in _items)
						{
							<option value="@item.Code">@item.Code - @item.Name</option>
						}
					</select>
				</div>

				<div class="col-md-3">
					<label class="form-label">Stok Adı</label>
					<input class="form-control" value="@_itemForm.ItemName" readonly />
				</div>

				<div class="col-md-3">
					<label class="form-label">Grup Kodu</label>
					<input class="form-control" value="@_itemForm.GroupCode" readonly />
				</div>

				<div class="col-md-3">
					<label class="form-label">Depo Kodu</label>
					<InputNumber class="form-control" @bind-Value="_itemForm.WarehouseCode" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Döviz Tipi</label>
					<InputSelect class="form-select" @bind-Value="_itemForm.CurrencyTypeId">
						<option value="0">Döviz tipi seçiniz</option>
						@foreach (var currencyType in _currencyTypes)
						{
							<option value="@currencyType.Id">@currencyType.Name</option>
						}
					</InputSelect>
				</div>

				<div class="col-md-3">
					<label class="form-label">Ölçü Birimi</label>
					<InputText class="form-control" @bind-Value="_itemForm.UnitOfMeasure" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Birim Fiyat</label>
					<InputNumber class="form-control" @bind-Value="_itemForm.UnitPrice" />
				</div>

				<div class="col-md-3">
					<label class="form-label">Miktar</label>
					<InputNumber class="form-control" @bind-Value="_itemForm.Quantity" />
				</div>

				<div class="col-md-3 d-grid">
					<button type="button" class="btn btn-primary" @onclick="AddItemAsync">Ekle</button>
				</div>
			</div>
		</div>
	</div>

	<div class="card mb-4">
		<div class="card-header fw-bold">Kalemler</div>
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-striped table-hover mb-0">
					<thead class="table-light">
						<tr>
							<th>Sıra</th>
							<th>Stok Kodu</th>
							<th>Stok Adı</th>
							<th>Grup Kodu</th>
							<th>Depo Kodu</th>
						<th>Döviz Tipi</th>
							<th>Ölçü Birimi</th>
							<th>Birim Fiyat</th>
							<th>Miktar</th>
							<th>Satır Tutarı</th>
						</tr>
					</thead>
					<tbody>
						@if (_orderItems.Count == 0)
						{
							<tr>
								<td colspan="10" class="text-center text-muted py-4">Henüz kalem eklenmedi.</td>
							</tr>
						}
						else
						{
							@for (var i = 0; i < _orderItems.Count; i++)
							{
								var line = _orderItems[i];
								<tr>
									<td>@(i + 1)</td>
									<td>@line.ItemCode</td>
									<td>@line.ItemName</td>
									<td>@line.GroupCode</td>
									<td>@line.WarehouseCode</td>
									<td>@(_currencyTypes.FirstOrDefault(x => x.Id == line.CurrencyTypeId)?.Name ?? line.CurrencyTypeId.ToString())</td>
									<td>@line.UnitOfMeasure</td>
									<td>@line.UnitPrice.ToString("N2")</td>
									<td>@line.Quantity</td>
									<td>@(line.UnitPrice * line.Quantity)</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-end gap-2">
		<button type="button" class="btn btn-success" @onclick="CompleteOrderAsync" disabled="@(!_orderItems.Any())">
			Siparişi Oluştur
		</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(_message))
	{
		<div class="alert alert-info mt-3">@_message</div>
	}
</div>

@code {
	private Order _order = new()
	{
		PaymentDate = DateTime.Today
	};

	private readonly OrderItem _itemForm = new()
	{
		Quantity = 1
	};

	private readonly List<OrderItem> _orderItems = new();
	private List<Customer> _customers = new();
	private List<CurrencyType> _currencyTypes = new();
	private List<Item> _items = new();
	private string? _message;
	private bool IsHeaderLocked => _orderItems.Count > 0;

	protected override async Task OnInitializedAsync()
	{
		_customers = (await LookupRepository.GetCustomersAsync()).ToList();
		_currencyTypes = (await LookupRepository.GetCurrencyTypesAsync()).ToList();
		_items = (await LookupRepository.GetItemsAsync()).ToList();
		RecalculateTotalAmount();
	}

	private void HandleItemCodeChanged(ChangeEventArgs args)
	{
		var itemCode = args.Value?.ToString() ?? string.Empty;
		_itemForm.ItemCode = itemCode;

		var selectedItem = _items.FirstOrDefault(x => x.Code == itemCode);

		if (selectedItem is null)
		{
			_itemForm.ItemName = string.Empty;
			_itemForm.GroupCode = string.Empty;
			_itemForm.UnitOfMeasure = string.Empty;
			return;
		}

		_itemForm.ItemName = selectedItem.Name;
		_itemForm.GroupCode = selectedItem.GroupCode;
		_itemForm.UnitOfMeasure = selectedItem.Unit;
	}

	private Task AddItemAsync()
	{
		if (string.IsNullOrWhiteSpace(_itemForm.ItemCode))
		{
			_message = "Lütfen stok kodu seçiniz.";
			return Task.CompletedTask;
		}

		if (_itemForm.Quantity < 1)
		{
			_message = "Miktar en az 1 olmalıdır.";
			return Task.CompletedTask;
		}

		if (_itemForm.UnitPrice < 0)
		{
			_message = "Birim fiyat negatif olamaz.";
			return Task.CompletedTask;
		}

		if (_itemForm.CurrencyTypeId == 0)
		{
			_message = "Lütfen döviz tipi seçiniz.";
			return Task.CompletedTask;
		}

		var currentWarehouseCode = _itemForm.WarehouseCode;
		var currentCurrencyTypeId = _itemForm.CurrencyTypeId;

		_orderItems.Add(new OrderItem
		{
			ItemCode = _itemForm.ItemCode,
			ItemName = _itemForm.ItemName,
			GroupCode = _itemForm.GroupCode,
			WarehouseCode = _itemForm.WarehouseCode,
			CurrencyTypeId = _itemForm.CurrencyTypeId,
			UnitOfMeasure = _itemForm.UnitOfMeasure,
			UnitPrice = _itemForm.UnitPrice,
			Quantity = _itemForm.Quantity
		});

		RecalculateTotalAmount();

		_itemForm.ItemCode = string.Empty;
		_itemForm.ItemName = string.Empty;
		_itemForm.GroupCode = string.Empty;
		_itemForm.UnitOfMeasure = string.Empty;
		_itemForm.UnitPrice = 0;
		_itemForm.Quantity = 1;
		_itemForm.WarehouseCode = currentWarehouseCode;
		_itemForm.CurrencyTypeId = currentCurrencyTypeId;

		_message = "Kalem eklendi.";
		return Task.CompletedTask;
	}

	private async Task CompleteOrderAsync()
	{
		if (_orderItems.Count == 0)
		{
			_message = "Kaydedilecek kalem bulunmuyor.";
			return;
		}

		_order.OrderItems = _orderItems.ToList();
		RecalculateTotalAmount();

		await OrderRepository.SaveOrderAsync(_order);

		_order = new Order
		{
			PaymentDate = DateTime.Today
		};

		_orderItems.Clear();

		_itemForm.ItemCode = string.Empty;
		_itemForm.ItemName = string.Empty;
		_itemForm.GroupCode = string.Empty;
		_itemForm.UnitOfMeasure = string.Empty;
		_itemForm.UnitPrice = 0;
		_itemForm.Quantity = 1;
		_itemForm.WarehouseCode = 0;
		_itemForm.CurrencyTypeId = 0;

		_message = "Sipariş başarıyla kaydedildi.";
	}

	private void RecalculateTotalAmount()
	{
		_order.TotalAmount = _orderItems.Sum(x => x.UnitPrice * x.Quantity);
	}
}