using Microsoft.EntityFrameworkCore;
using OrderManagementSystem.Domain.Entities;
using OrderManagementSystem.Domain.Interfaces;
using OrderManagementSystem.DataAccess.Context;

namespace OrderManagementSystem.DataAccess.Repositories;

public class LookupRepository : ILookupRepository
{
    private readonly OrderDbContext _context;

    public LookupRepository(OrderDbContext context)
    {
        _context = context;
    }

    public async Task<IEnumerable<Customer>> GetCustomersAsync()
    {
        return await _context.Customers.AsNoTracking().ToListAsync();
    }

    public async Task<IEnumerable<CurrencyType>> GetCurrencyTypesAsync()
    {
        return await _context.CurrencyTypes.AsNoTracking().ToListAsync();
    }

    public async Task<IEnumerable<Item>> GetItemsAsync()
    {
        return await _context.Items.AsNoTracking().ToListAsync();
    }
}