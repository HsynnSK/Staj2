@page "/orders"
@rendermode InteractiveServer

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@inject IOrderRepository OrderRepository

<PageTitle>Siparişler</PageTitle>

<div class="container py-4">
	<h3 class="mb-4">Siparişler</h3>

	@if (_orders.Count == 0)
	{
		<div class="alert alert-info">Henüz kayıtlı sipariş bulunmuyor.</div>
	}
	else
	{
		<div class="row g-4">
			<div class="col-lg-5">
				<div class="card h-100">
					<div class="card-header fw-bold">Sipariş Listesi</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table table-hover mb-0 align-middle">
								<thead class="table-light">
									<tr>
										<th>Sipariş</th>
										<th>Cari</th>
										<th>Tarih</th>
										<th>Toplam</th>
										<th></th>
									</tr>
								</thead>
								<tbody>
									@foreach (var order in _orders)
									{
										<tr class="@(ReferenceEquals(order, _selectedOrder) ? "table-primary" : string.Empty)">
											<td>@order.Id</td>
											<td>@(order.Customer?.Name ?? string.Empty)</td>
											<td>@(order.Invoice?.InvoiceDate.ToString("dd.MM.yyyy HH:mm") ?? string.Empty)</td>
											<td>@(order.Invoice?.GrandTotal ?? string.Empty)</td>
											<td class="text-end">
												<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectOrder(order)">Detay</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-7">
				@if (_selectedOrder is null)
				{
					<div class="alert alert-warning">Detay görmek için bir sipariş seçin.</div>
				}
				else
				{
					<div class="card mb-4">
						<div class="card-header fw-bold">Sipariş Detayı</div>
						<div class="card-body">
							<div class="row g-3">
								<div class="col-md-4">
									<div class="text-muted small">Sipariş No</div>
									<div class="fw-semibold">@_selectedOrder.Id</div>
								</div>
								<div class="col-md-4">
									<div class="text-muted small">Cari</div>
									<div class="fw-semibold">@(_selectedOrder.Customer?.Name ?? string.Empty)</div>
								</div>
								<div class="col-md-4">
									<div class="text-muted small">Ödeme Tarihi</div>
									<div class="fw-semibold">@_selectedOrder.PaymentDate.ToString("dd.MM.yyyy")</div>
								</div>
								<div class="col-md-4">
									<div class="text-muted small">Fatura No</div>
									<div class="fw-semibold">@(_selectedOrder.Invoice?.InvoiceNumber ?? string.Empty)</div>
								</div>
								<div class="col-md-4">
									<div class="text-muted small">Fatura Tarihi</div>
									<div class="fw-semibold">@(_selectedOrder.Invoice?.InvoiceDate.ToString("dd.MM.yyyy HH:mm") ?? string.Empty)</div>
								</div>
								<div class="col-md-4">
									<div class="text-muted small">Toplam Tutar</div>
									<div class="fw-semibold">@(_selectedOrder.Invoice?.GrandTotal ?? string.Empty)</div>
								</div>
							</div>
						</div>
					</div>

					<div class="card">
						<div class="card-header fw-bold">Sipariş Kalemleri</div>
						<div class="card-body p-0">
							<div class="table-responsive">
								<table class="table table-striped table-hover mb-0 align-middle">
									<thead class="table-light">
										<tr>
											<th>#</th>
											<th>Stok Kodu</th>
											<th>Stok Adı</th>
											<th>Grup</th>
											<th>Depo</th>
											<th>Döviz</th>
											<th>Birim</th>
											<th>Birim Fiyat</th>
											<th>Miktar</th>
											<th>Tutar</th>
										</tr>
									</thead>
									<tbody>
										@if (!_selectedOrder.OrderItems.Any())
										{
											<tr>
												<td colspan="10" class="text-center text-muted py-4">Bu siparişe ait kalem bulunmuyor.</td>
											</tr>
										}
										else
										{
											@for (var i = 0; i < _selectedOrder.OrderItems.Count; i++)
											{
												var line = _selectedOrder.OrderItems.ElementAt(i);
												<tr>
													<td>@(i + 1)</td>
													<td>@(line.Item?.Code ?? string.Empty)</td>
													<td>@(line.Item?.Name ?? string.Empty)</td>
													<td>@(line.Item?.GroupCode ?? string.Empty)</td>
													<td>@(line.Item?.Warehouse?.Name ?? string.Empty)</td>
													<td>@(line.CurrencyType?.Name ?? string.Empty)</td>
													<td>@(line.Item?.UnitOfMeasure ?? line.Item?.Unit ?? string.Empty)</td>
													<td>@line.UnitPrice.ToString("N2")</td>
													<td>@line.Quantity</td>
													<td>@FormatLineTotal(line)</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
</div>

@code {
	private List<Order> _orders = new();
	private Order? _selectedOrder;

	protected override async Task OnInitializedAsync()
	{
		_orders = (await OrderRepository.GetOrdersAsync()).ToList();
		_selectedOrder = _orders.FirstOrDefault();
	}

	private void SelectOrder(Order order)
	{
		_selectedOrder = order;
	}

	private static string FormatLineTotal(OrderItem orderItem)
	{
		var currencyName = orderItem.CurrencyType?.Name ?? string.Empty;
		return string.IsNullOrWhiteSpace(currencyName)
			? (orderItem.UnitPrice * orderItem.Quantity).ToString("N2")
			: $"{(orderItem.UnitPrice * orderItem.Quantity):N2} {currencyName}";
	}
}
