using Microsoft.EntityFrameworkCore;
using OrderSystemManagment.Domain.Entities;
using OrderSystemManagment.Domain.Interfaces;
using OrderSystemManagment.DataAccess.Context;

namespace OrderSystemManagment.DataAccess.Repositories;

public class OrderRepository : IOrderRepository
{
    private readonly OrderDbContext _context;

    public OrderRepository(OrderDbContext context)
    {
        _context = context;
    }

    public async Task SaveOrderAsync(Order order)
    {
        await using var transaction = await _context.Database.BeginTransactionAsync();

        var generatedNo = await GenerateOrderNumberAsync();

        var invoice = new Invoice
        {
            InvoiceNumber = generatedNo,
            InvoiceType = string.Empty,
            InvoiceDate = DateTime.Now,
            GrandTotal = string.Empty
        };

        order.Invoice = invoice;

        if (order.Customer is not null)
        {
            _context.Attach(order.Customer);
            _context.Entry(order.Customer).State = EntityState.Unchanged;
            _context.Entry(order).Property("CustomerId").CurrentValue = order.Customer.Id;
        }

        invoice.GrandTotal = BuildGrandTotalSummary(order.OrderItems);

        foreach (var orderItem in order.OrderItems)
        {
            if (orderItem.Item is not null)
            {
                _context.Attach(orderItem.Item);
                _context.Entry(orderItem.Item).State = EntityState.Unchanged;
                _context.Entry(orderItem).Property("ItemId").CurrentValue = orderItem.Item.Id;
            }

            if (orderItem.CurrencyType is not null)
            {
                _context.Attach(orderItem.CurrencyType);
                _context.Entry(orderItem.CurrencyType).State = EntityState.Unchanged;
                _context.Entry(orderItem).Property("CurrencyTypeId").CurrentValue = orderItem.CurrencyType.Id;
            }
        }

        await _context.Orders.AddAsync(order);
        await _context.SaveChangesAsync();

        await transaction.CommitAsync();
    }

    private async Task<string> GenerateOrderNumberAsync()
    {
        var year = DateTime.Now.Year;
        var prefix = $"INV{year}";

        var existingNumbers = await _context.Invoices
            .AsNoTracking()
            .Where(x => x.InvoiceNumber.StartsWith(prefix))
            .Select(x => x.InvoiceNumber)
            .ToListAsync();

        var nextSequence = existingNumbers
            .Select(x => x.Length >= prefix.Length + 7 && int.TryParse(x.Substring(prefix.Length, 7), out var number)
                ? number
                : 0)
            .DefaultIfEmpty(0)
            .Max() + 1;

        return $"{prefix}{nextSequence:D7}";
    }

    private static string BuildGrandTotalSummary(IEnumerable<OrderItem> orderItems)
    {
        var lineSummaries = orderItems
            .Where(x => x.CurrencyType is not null)
            .GroupBy(x => x.CurrencyType!.Name)
            .Select(group => $"{group.Sum(x => x.UnitPrice * x.Quantity):N2} {group.Key}")
            .ToList();

        return lineSummaries.Count == 0 ? string.Empty : string.Join(" + ", lineSummaries);
    }
}