@page "/orders"
@rendermode InteractiveServer

@using OrderSystemManagment.Domain.Entities
@using OrderSystemManagment.Domain.Interfaces
@inject ILookupRepository LookupRepository
@inject IOrderRepository OrderRepository

<PageTitle>Siparişler</PageTitle>

<div class="container py-4">
	<h3 class="mb-4">Siparişler</h3>

	@if (_orders.Count == 0)
	{
		<div class="alert alert-info">Henüz kayıtlı sipariş bulunmuyor.</div>
	}
	else
	{
		<div class="row g-4">
			<div class="col-lg-5">
				<div class="card h-100">
					<div class="card-header fw-bold">Sipariş Listesi</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table table-hover mb-0 align-middle">
								<thead class="table-light">
									<tr>
										<th>Sipariş</th>
										<th>Cari</th>
										<th>Tarih</th>
										<th>Toplam</th>
										<th></th>
									</tr>
								</thead>
								<tbody>
									@foreach (var order in _orders)
									{
										<tr class="@(IsSelectedOrder(order) ? "table-primary" : string.Empty)">
											<td>@order.Id</td>
											<td>@(order.Customer?.Name ?? string.Empty)</td>
											<td>@(order.Invoice is null ? string.Empty : order.Invoice.InvoiceDate.ToString("dd.MM.yyyy HH:mm"))</td>
											<td>@(order.Invoice?.GrandTotal ?? string.Empty)</td>
											<td class="text-end">
												<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectOrder(order)">Detay</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
		</div>

		<div class="col-lg-7">
			@if (_selectedOrder is null)
			{
				<div class="alert alert-warning">Detay görmek için bir sipariş seçin.</div>
			}
			else
			{
				var selectedOrder = _selectedOrder;

				<div class="card mb-4">
					<div class="card-header d-flex justify-content-between align-items-center">
						<span class="fw-bold">Sipariş Detayı</span>
						<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BeginEditSelectedOrder" disabled="@(_editableOrder is not null)">Düzenle</button>
					</div>
					<div class="card-body">
						<div class="row g-3">
							<div class="col-md-4">
								<div class="text-muted small">Sipariş No</div>
								<div class="fw-semibold">@selectedOrder.Id</div>
							</div>
							<div class="col-md-4">
								<div class="text-muted small">Cari</div>
								<div class="fw-semibold">@(selectedOrder.Customer?.Name ?? string.Empty)</div>
							</div>
							<div class="col-md-4">
								<div class="text-muted small">Ödeme Tarihi</div>
								<div class="fw-semibold">@selectedOrder.PaymentDate.ToString("dd.MM.yyyy")</div>
							</div>
							<div class="col-md-4">
								<div class="text-muted small">Fatura No</div>
								<div class="fw-semibold">@(selectedOrder.Invoice?.InvoiceNumber ?? string.Empty)</div>
							</div>
							<div class="col-md-4">
								<div class="text-muted small">Fatura Tarihi</div>
								<div class="fw-semibold">@(selectedOrder.Invoice is null ? string.Empty : selectedOrder.Invoice.InvoiceDate.ToString("dd.MM.yyyy HH:mm"))</div>
							</div>
							<div class="col-md-4">
								<div class="text-muted small">Toplam Tutar</div>
								<div class="fw-semibold">@(selectedOrder.Invoice?.GrandTotal ?? string.Empty)</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-4">
					<div class="card-header fw-bold">Sipariş Kalemleri</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table table-striped table-hover mb-0 align-middle">
								<thead class="table-light">
									<tr>
										<th>#</th>
										<th>Stok Kodu</th>
										<th>Stok Adı</th>
										<th>Grup</th>
										<th>Depo</th>
										<th>Döviz</th>
										<th>Birim</th>
										<th>Birim Fiyat</th>
										<th>Miktar</th>
										<th>Tutar</th>
									</tr>
								</thead>
								<tbody>
									@if (!selectedOrder.OrderItems.Any())
									{
										<tr>
											<td colspan="10" class="text-center text-muted py-4">Bu siparişe ait kalem bulunmuyor.</td>
										</tr>
									}
									else
									{
										@for (var i = 0; i < selectedOrder.OrderItems.Count; i++)
										{
											var line = selectedOrder.OrderItems.ElementAt(i);
											<tr>
												<td>@(i + 1)</td>
												<td>@(line.Item?.Code ?? string.Empty)</td>
												<td>@(line.Item?.Name ?? string.Empty)</td>
												<td>@(line.Item?.GroupCode ?? string.Empty)</td>
												<td>@(line.Item?.Warehouse?.Name ?? string.Empty)</td>
												<td>@(line.CurrencyType?.Name ?? string.Empty)</td>
												<td>@(line.Item?.UnitOfMeasure ?? line.Item?.Unit ?? string.Empty)</td>
												<td>@line.UnitPrice.ToString("N2")</td>
												<td>@line.Quantity</td>
												<td>@FormatLineTotal(line)</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>

				@if (_editableOrder is not null)
				{
					var editableOrder = _editableOrder;

					<div class="card mb-4">
						<div class="card-header fw-bold">Siparişi Güncelle</div>
						<div class="card-body">
							<div class="row g-3">
								<div class="col-md-4">
									<label class="form-label">Cari</label>
									@if (!_customers.Any())
									{
										<select class="form-select" disabled>
											<option value="" disabled hidden>Cari seçiniz</option>
										</select>
									}
									else
									{
										<select class="form-select" value="@(_editableCustomerCode ?? string.Empty)" @onchange="HandleEditableCustomerChanged">
											<option value="" disabled hidden>Cari seçiniz</option>
											@foreach (var customer in _customers)
											{
												<option value="@customer.Code">@customer.Name</option>
											}
										</select>
									}
								</div>

								<div class="col-md-4">
									<label class="form-label">Ödeme Tarihi</label>
									<InputDate class="form-control" @bind-Value="editableOrder.PaymentDate" />
								</div>

								<div class="col-md-4">
									<label class="form-label">Toplam Tutar</label>
									<InputText class="form-control" value="@(editableOrder.Invoice?.GrandTotal ?? string.Empty)" readonly />
								</div>
							</div>

							<div class="row g-3 align-items-end mt-3">
								<div class="col-md-3">
									<label class="form-label">Stok Kodu</label>
									<select class="form-select" value="@_itemDraft.ItemCode" @onchange="HandleItemCodeChanged">
										<option value="" disabled hidden>Stok seçiniz</option>
										@foreach (var item in _items)
										{
											<option value="@item.Code">@item.Code - @item.Name</option>
										}
									</select>
								</div>

								<div class="col-md-3">
									<label class="form-label">Stok Adı</label>
									<input class="form-control" value="@_itemDraft.ItemName" readonly />
								</div>

								<div class="col-md-3">
									<label class="form-label">Grup Kodu</label>
									<input class="form-control" value="@_itemDraft.GroupCode" readonly />
								</div>

								<div class="col-md-3">
									<label class="form-label">Depo</label>
									@if (!_warehouses.Any())
									{
										<select class="form-select" disabled>
											<option value="">Depo kodu seçiniz</option>
										</select>
									}
									else
									{
										<select class="form-select" value="@(_selectedWarehouseId?.ToString() ?? string.Empty)" disabled="@string.IsNullOrWhiteSpace(_itemDraft.ItemCode)" @onchange="OnWarehouseChanged">
											<option value="">Depo kodu seçiniz</option>
											@foreach (var warehouse in _warehouses)
											{
												@if (_itemDraft.ItemCode == string.Empty || _items.FirstOrDefault(x => x.Code == _itemDraft.ItemCode)?.Warehouse?.Id == warehouse.Id)
												{
													<option value="@warehouse.Id">@warehouse.Id - @warehouse.Name</option>
												}
											}
										</select>
									}
								</div>

								<div class="col-md-3">
									<label class="form-label">Döviz Tipi</label>
									<InputSelect class="form-select" @bind-Value="_itemDraft.CurrencyTypeId">
										<option value="0" disabled hidden>Döviz tipi seçiniz</option>
										@foreach (var currencyType in _currencyTypes)
										{
											<option value="@currencyType.Id">@currencyType.Name</option>
										}
									</InputSelect>
								</div>

								<div class="col-md-3">
									<label class="form-label">Ölçü Birimi</label>
									<InputText class="form-control" @bind-Value="_itemDraft.Unit" />
								</div>

								<div class="col-md-3">
									<label class="form-label">Birim Fiyat</label>
									<InputNumber class="form-control" @bind-Value="_itemDraft.UnitPrice" />
								</div>

								<div class="col-md-3">
									<label class="form-label">Miktar</label>
									<InputNumber class="form-control" @bind-Value="_itemDraft.Quantity" />
								</div>

								<div class="col-md-3 d-grid">
									<button type="button" class="btn btn-primary" @onclick="AddOrUpdateEditableItemAsync">@(_editingOrderItemIndex.HasValue ? "Güncelle" : "Ekle")</button>
								</div>
							</div>

							@if (_editingOrderItemIndex.HasValue)
							{
								<div class="alert alert-warning mt-3 mb-0">Kalem düzenleniyor. Güncelle butonuyla kaydedin.</div>
							}

							<div class="table-responsive mt-3">
								<table class="table table-striped table-hover mb-0 align-middle">
									<thead class="table-light">
										<tr>
											<th>#</th>
											<th>Stok Kodu</th>
											<th>Stok Adı</th>
											<th>Grup</th>
											<th>Depo</th>
											<th>Döviz</th>
											<th>Birim</th>
											<th>Birim Fiyat</th>
											<th>Miktar</th>
											<th>Tutar</th>
											<th>İşlem</th>
										</tr>
									</thead>
									<tbody>
										@if (editableOrder.OrderItems.Count == 0)
										{
											<tr>
												<td colspan="11" class="text-center text-muted py-4">Henüz kalem eklenmedi.</td>
											</tr>
										}
										else
										{
											@for (var i = 0; i < editableOrder.OrderItems.Count; i++)
											{
												var itemIndex = i;
												var line = editableOrder.OrderItems.ElementAt(i);
												<tr>
													<td>@(i + 1)</td>
													<td>@(line.Item?.Code ?? string.Empty)</td>
													<td>@(line.Item?.Name ?? string.Empty)</td>
													<td>@(line.Item?.GroupCode ?? string.Empty)</td>
													<td>@(line.Item?.Warehouse?.Name ?? string.Empty)</td>
													<td>@(line.CurrencyType?.Name ?? string.Empty)</td>
													<td>@(line.Item?.UnitOfMeasure ?? line.Item?.Unit ?? string.Empty)</td>
													<td>@line.UnitPrice.ToString("N2")</td>
													<td>@line.Quantity</td>
													<td>@FormatLineTotal(line)</td>
													<td class="text-nowrap">
														<button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginEditOrderItem(itemIndex)">Düzenle</button>
														<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEditableOrderItem(itemIndex)">Kaldır</button>
													</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>

							<div class="d-flex justify-content-end gap-2 mt-3">
								<button type="button" class="btn btn-secondary" @onclick="CancelEditing">İptal</button>
								<button type="button" class="btn btn-success" @onclick="SaveEditedOrderAsync" disabled="@(!editableOrder.OrderItems.Any())">Güncelle</button>
							</div>
						</div>
					</div>
				}
			}
		</div>
	</div>
}
</div>

@code {
	private List<Order> _orders = new();
	private List<Customer> _customers = new();
	private List<CurrencyType> _currencyTypes = new();
	private List<Item> _items = new();
	private List<Warehouse> _warehouses = new();
	private Order? _selectedOrder;
	private Order? _editableOrder;
	private string? _editableCustomerCode;
	private readonly OrderItemDraft _itemDraft = new()
	{
		Quantity = 1
	};
	private int? _editingOrderItemIndex;
	private string? _message;

	protected override async Task OnInitializedAsync()
	{
		await LoadDataAsync();
		_selectedOrder = _orders.FirstOrDefault();
	}

	private async Task LoadDataAsync()
	{
		_customers = (await LookupRepository.GetCustomersAsync()).ToList();
		_currencyTypes = (await LookupRepository.GetCurrencyTypesAsync()).ToList();
		_items = (await LookupRepository.GetItemsAsync()).ToList();
		_warehouses = (await LookupRepository.GetWarehousesAsync()).ToList();
		_orders = (await OrderRepository.GetOrdersAsync()).ToList();
	}

	private void SelectOrder(Order order)
	{
		_selectedOrder = order;
		_message = null;
		if (_editableOrder is not null && _editableOrder.Id != order.Id)
		{
			CancelEditing();
		}
	}

	private void BeginEditSelectedOrder()
	{
		if (_selectedOrder is null)
		{
			return;
		}

		_editableOrder = CloneOrder(_selectedOrder);
		_editableCustomerCode = _editableOrder.Customer?.Code;
		ResetItemDraft();
		_message = "Sipariş düzenleme moduna alındı.";
	}

	private void CancelEditing()
	{
		_editableOrder = null;
		_editingOrderItemIndex = null;
		_editableCustomerCode = null;
		ResetItemDraft();
		_message = "Düzenleme iptal edildi.";
	}

	private void HandleEditableCustomerChanged(ChangeEventArgs args)
	{
		_editableCustomerCode = args.Value?.ToString();
	}

	private void HandleItemCodeChanged(ChangeEventArgs args)
	{
		if (_editableOrder is null)
		{
			return;
		}

		var itemCode = args.Value?.ToString() ?? string.Empty;
		_itemDraft.ItemCode = itemCode;

		var selectedItem = _items.FirstOrDefault(x => x.Code == itemCode);
		if (selectedItem is null)
		{
			_itemDraft.ItemName = string.Empty;
			_itemDraft.GroupCode = string.Empty;
			_itemDraft.Unit = string.Empty;
			_itemDraft.WarehouseName = string.Empty;
			_selectedWarehouseId = null;
			return;
		}

		_itemDraft.ItemName = selectedItem.Name;
		_itemDraft.GroupCode = selectedItem.GroupCode;
		_itemDraft.Unit = selectedItem.Unit;
		_itemDraft.WarehouseName = string.Empty;
		_selectedWarehouseId = null;

		if (selectedItem.Warehouse is not null)
		{
			_selectedWarehouseId = selectedItem.Warehouse.Id;
			_itemDraft.WarehouseName = selectedItem.Warehouse.Name;
		}
	}

	private int? _selectedWarehouseId;

	private void OnWarehouseChanged(ChangeEventArgs args)
	{
		if (int.TryParse(args.Value?.ToString(), out var warehouseId))
		{
			_selectedWarehouseId = warehouseId;
			_itemDraft.WarehouseName = _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Name ?? string.Empty;
		}
		else
		{
			_selectedWarehouseId = null;
			_itemDraft.WarehouseName = string.Empty;
		}
	}

	private Task AddOrUpdateEditableItemAsync()
	{
		if (_editableOrder is null)
		{
			_message = "Düzenlenecek sipariş seçilmedi.";
			return Task.CompletedTask;
		}

		if (string.IsNullOrWhiteSpace(_editableCustomerCode))
		{
			_message = "Lütfen önce cari seçiniz.";
			return Task.CompletedTask;
		}

		if (_editableOrder.PaymentDate == default)
		{
			_message = "Lütfen önce ödeme tarihi seçiniz.";
			return Task.CompletedTask;
		}

		if (string.IsNullOrWhiteSpace(_itemDraft.ItemCode))
		{
			_message = "Lütfen stok kodu seçiniz.";
			return Task.CompletedTask;
		}

		if (_itemDraft.Quantity < 1)
		{
			_message = "Miktar en az 1 olmalıdır.";
			return Task.CompletedTask;
		}

		if (_itemDraft.UnitPrice < 0)
		{
			_message = "Birim fiyat negatif olamaz.";
			return Task.CompletedTask;
		}

		if (_itemDraft.CurrencyTypeId == 0)
		{
			_message = "Lütfen döviz tipi seçiniz.";
			return Task.CompletedTask;
		}

		var selectedCurrencyType = _currencyTypes.FirstOrDefault(x => x.Id == _itemDraft.CurrencyTypeId);
		var selectedItem = _items.FirstOrDefault(x => x.Code == _itemDraft.ItemCode);

		if (selectedCurrencyType is null)
		{
			_message = "Seçilen döviz tipi bulunamadı.";
			return Task.CompletedTask;
		}

		if (selectedItem is null)
		{
			_message = "Seçilen stok bulunamadı.";
			return Task.CompletedTask;
		}

		var newOrderItem = new OrderItem
		{
			Item = selectedItem,
			CurrencyType = selectedCurrencyType,
			UnitPrice = _itemDraft.UnitPrice,
			Quantity = _itemDraft.Quantity
		};

		if (_editingOrderItemIndex is int editingIndex && editingIndex >= 0 && editingIndex < _editableOrder.OrderItems.Count)
		{
			_editableOrder.OrderItems.ElementAt(editingIndex).Item = selectedItem;
			_editableOrder.OrderItems.ElementAt(editingIndex).CurrencyType = selectedCurrencyType;
			_editableOrder.OrderItems.ElementAt(editingIndex).UnitPrice = _itemDraft.UnitPrice;
			_editableOrder.OrderItems.ElementAt(editingIndex).Quantity = _itemDraft.Quantity;
			_message = "Kalem güncellendi.";
		}
		else
		{
			_editableOrder.OrderItems.Add(newOrderItem);
			_message = "Kalem eklendi.";
		}

		RecalculateEditableTotal();
		ResetItemDraft(_itemDraft.CurrencyTypeId);
		return Task.CompletedTask;
	}

	private void BeginEditOrderItem(int index)
	{
		if (_editableOrder is null || index < 0 || index >= _editableOrder.OrderItems.Count)
		{
			return;
		}

		var orderItem = _editableOrder.OrderItems.ElementAt(index);
		var item = orderItem.Item;
		var warehouse = item?.Warehouse;
		var currencyType = orderItem.CurrencyType;

		_itemDraft.ItemCode = item?.Code ?? string.Empty;
		_itemDraft.ItemName = item?.Name ?? string.Empty;
		_itemDraft.GroupCode = item?.GroupCode ?? string.Empty;
		_itemDraft.Unit = item?.Unit ?? string.Empty;
		_itemDraft.UnitPrice = orderItem.UnitPrice;
		_itemDraft.Quantity = orderItem.Quantity;
		_itemDraft.CurrencyTypeId = currencyType?.Id ?? 0;
		_itemDraft.WarehouseName = warehouse?.Name ?? string.Empty;
		_selectedWarehouseId = warehouse?.Id;
		_editingOrderItemIndex = index;
		_message = "Kalem düzenleme için yüklendi.";
	}

	private void RemoveEditableOrderItem(int index)
	{
		if (_editableOrder is null || index < 0 || index >= _editableOrder.OrderItems.Count)
		{
			return;
		}

		_editableOrder.OrderItems.Remove(_editableOrder.OrderItems.ElementAt(index));

		if (_editingOrderItemIndex == index)
		{
			ResetItemDraft();
		}
		else if (_editingOrderItemIndex is int editingIndex && editingIndex > index)
		{
			_editingOrderItemIndex = editingIndex - 1;
		}

		RecalculateEditableTotal();
		_message = "Kalem kaldırıldı.";
	}

	private async Task SaveEditedOrderAsync()
	{
		if (_editableOrder is null)
		{
			_message = "Düzenlenecek sipariş seçilmedi.";
			return;
		}

		if (string.IsNullOrWhiteSpace(_editableCustomerCode))
		{
			_message = "Lütfen önce cari seçiniz.";
			return;
		}

		if (_editableOrder.PaymentDate == default)
		{
			_message = "Lütfen önce ödeme tarihi seçiniz.";
			return;
		}

		if (!_editableOrder.OrderItems.Any())
		{
			_message = "Kaydedilecek kalem bulunmuyor.";
			return;
		}

		_editableOrder.Customer = _customers.FirstOrDefault(x => x.Code == _editableCustomerCode);
		if (_editableOrder.Customer is null)
		{
			_message = "Seçilen cari bulunamadı.";
			return;
		}

		RecalculateEditableTotal();

		var orderId = _editableOrder.Id;
		await OrderRepository.UpdateOrderAsync(_editableOrder);

		await LoadDataAsync();
		_selectedOrder = _orders.FirstOrDefault(x => x.Id == orderId);
		_editableOrder = null;
		_editableCustomerCode = null;
		_editingOrderItemIndex = null;
		ResetItemDraft();
		_message = "Sipariş güncellendi.";
	}

	private void RecalculateEditableTotal()
	{
		if (_editableOrder?.Invoice is not null)
		{
			_editableOrder.Invoice.GrandTotal = BuildGrandTotalSummary(_editableOrder.OrderItems);
		}
	}

	private string BuildGrandTotalSummary(IEnumerable<OrderItem> orderItems)
	{
		var lineSummaries = orderItems
			.Where(x => x.CurrencyType is not null)
			.GroupBy(x => x.CurrencyType!.Name)
			.Select(group => $"{FormatMoney(group.Sum(x => x.UnitPrice * x.Quantity), group.First().CurrencyType)}")
			.ToList();

		return lineSummaries.Count == 0 ? string.Empty : string.Join(" + ", lineSummaries);
	}

	private static string FormatLineTotal(OrderItem orderItem)
	{
		return FormatMoney(orderItem.UnitPrice * orderItem.Quantity, orderItem.CurrencyType);
	}

	private static string FormatMoney(decimal amount, CurrencyType? currencyType)
	{
		var currencyName = currencyType?.Name ?? string.Empty;
		var format = UsesNoDecimalPlaces(currencyName) ? "N0" : "N2";

		return string.IsNullOrWhiteSpace(currencyName)
			? amount.ToString(format)
			: $"{amount.ToString(format)} {currencyName}";
	}

	private static bool UsesNoDecimalPlaces(string currencyName)
	{
		return currencyName.Contains("JPY", StringComparison.OrdinalIgnoreCase)
			|| currencyName.Contains("Yen", StringComparison.OrdinalIgnoreCase)
			|| currencyName.Contains("Japon", StringComparison.OrdinalIgnoreCase)
			|| currencyName.Contains("Yeni", StringComparison.OrdinalIgnoreCase)
			|| currencyName.Contains("日本円", StringComparison.OrdinalIgnoreCase);
	}

	private void ResetItemDraft(int currencyTypeId = 0)
	{
		_itemDraft.ItemCode = string.Empty;
		_itemDraft.ItemName = string.Empty;
		_itemDraft.GroupCode = string.Empty;
		_itemDraft.Unit = string.Empty;
		_itemDraft.UnitPrice = 0;
		_itemDraft.Quantity = 1;
		_itemDraft.CurrencyTypeId = currencyTypeId;
		_itemDraft.WarehouseName = string.Empty;
		_selectedWarehouseId = null;
		_editingOrderItemIndex = null;
	}

	private static Order CloneOrder(Order source)
	{
		return new Order
		{
			Id = source.Id,
			PaymentDate = source.PaymentDate,
			Customer = CloneCustomer(source.Customer),
			Invoice = CloneInvoice(source.Invoice),
			OrderItems = source.OrderItems.Select(CloneOrderItem).ToList()
		};
	}

	private static Customer? CloneCustomer(Customer? source)
	{
		return source is null
			? null
			: new Customer
			{
				Id = source.Id,
				Code = source.Code,
				Name = source.Name
			};
	}

	private static Invoice? CloneInvoice(Invoice? source)
	{
		return source is null
			? null
			: new Invoice
			{
				Id = source.Id,
				InvoiceNumber = source.InvoiceNumber,
				InvoiceType = source.InvoiceType,
				InvoiceDate = source.InvoiceDate,
				GrandTotal = source.GrandTotal
			};
	}

	private static OrderItem CloneOrderItem(OrderItem source)
	{
		return new OrderItem
		{
			Id = source.Id,
			UnitPrice = source.UnitPrice,
			Quantity = source.Quantity,
			Item = CloneItem(source.Item),
			CurrencyType = CloneCurrencyType(source.CurrencyType)
		};
	}

	private static Item? CloneItem(Item? source)
	{
		return source is null
			? null
			: new Item
			{
				Id = source.Id,
				Code = source.Code,
				Name = source.Name,
				GroupCode = source.GroupCode,
				Unit = source.Unit,
				UnitOfMeasure = source.UnitOfMeasure,
				Warehouse = CloneWarehouse(source.Warehouse)
			};
	}

	private static Warehouse? CloneWarehouse(Warehouse? source)
	{
		return source is null
			? null
			: new Warehouse
			{
				Id = source.Id,
				Name = source.Name
			};
	}

	private static CurrencyType? CloneCurrencyType(CurrencyType? source)
	{
		return source is null
			? null
			: new CurrencyType
			{
				Id = source.Id,
				Name = source.Name
			};
	}

	private sealed class OrderItemDraft
	{
		public string ItemCode { get; set; } = string.Empty;

		public string ItemName { get; set; } = string.Empty;

		public string GroupCode { get; set; } = string.Empty;

		public string WarehouseName { get; set; } = string.Empty;

		public string Unit { get; set; } = string.Empty;

		public int CurrencyTypeId { get; set; }

		public decimal UnitPrice { get; set; }

		public int Quantity { get; set; }
	}
}
