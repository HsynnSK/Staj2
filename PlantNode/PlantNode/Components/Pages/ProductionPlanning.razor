@page "/production-planning"
@rendermode InteractiveServer
@using PlantNode.Domain.Entities.Production
@using PlantNode.Domain.Entities.Machines
@using PlantNode.Domain.Entities.Products
@using PlantNode.Domain.Enums
@inject IProductionPlanService ProductionPlanService
@inject IProductService ProductService
@inject IMachineService MachineService
@inject ICoilWindingSpeedStrategyFactory SpeedStrategyFactory
@implements IDisposable
@inject IPlanEventService PlanEventService

<PageTitle>Üretim Planlama - PlantNode</PageTitle>

<div class="page-header">
    <h1>
        <i class="bi bi-calendar-range" style="color: var(--accent-primary);"></i>
        Üretim Planlama
    </h1>
</div>

@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Yükleniyor...</span>
    </div>
}
else
{
    <!-- Top Demand Pool Bar (Minimalist Horizontal Strip) -->
    <div class="demands-top-bar animate-in" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1.25rem; margin-bottom: 1rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.5rem; text-align: left;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px; color: var(--accent-primary); font-weight: 700; font-size: 0.9rem;">
                <i class="bi bi-box-seam"></i> Talepler Havuzu (@dbDemands.Count)
            </div>
            <button class="btn-pn primary sm" style="padding: 4px 10px; font-size: 0.75rem; margin-bottom: 0;" @onclick="() => OpenAddDemandModal()">
                <i class="bi bi-plus-circle"></i> Yeni Talep Ekle
            </button>
        </div>
        
        <div class="demands-horizontal-scroll" style="display: flex; gap: 10px; overflow-x: auto; padding: 4px 2px; scrollbar-width: thin; -ms-overflow-style: none;">
            @if (!dbDemands.Any())
            {
                <div style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: rgb(16, 185, 129); padding: 0.25rem 0;">
                    <i class="bi bi-check-circle-fill"></i> Tüm üretim talepleri planlandı!
                </div>
            }
            else
            {
                @foreach (var demand in dbDemands)
                {
                    var product = demand.PlanProducts.FirstOrDefault()?.Product;
                    var prodName = product?.Name ?? "Bilinmeyen Ürün";
                    var prodCode = product?.ProductCode ?? "PRD-UNK";
                    
                    <div class="demand-top-card"
                         draggable="true"
                         @ondragstart="() => HandleDragStart(demand)"
                         @ondragend="HandleDragEnd"
                         style="flex: 0 0 230px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 8px; cursor: grab; position: relative; transition: all 0.2s ease; display: flex; flex-direction: column; gap: 3px;"
                         onmouseover="this.style.borderColor='var(--accent-primary)'; this.style.background='rgba(244,117,43,0.02)';"
                         onmouseout="this.style.borderColor='var(--border-color)'; this.style.background='rgba(255,255,255,0.02)';">
                        
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                            <div style="font-weight: 700; font-size: 0.75rem; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 140px;" title="@prodName">@prodName</div>
                            <div style="display: flex; gap: 3px;">
                                <button class="btn-pn secondary icon-btn" @onclick:stopPropagation="true" @onclick="() => OpenEditDemandModal(demand)" style="padding: 1px 4px; font-size: 0.6rem; border-radius: 3px;" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn-pn danger icon-btn" @onclick:stopPropagation="true" @onclick="() => DeleteDemand(demand.Id)" style="padding: 1px 4px; font-size: 0.6rem; border-radius: 3px;" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div style="font-family: monospace; font-size: 0.65rem; color: var(--text-secondary);">@demand.PlanCode (@prodCode)</div>
                        
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2px; border-top: 1px dashed rgba(255,255,255,0.06); padding-top: 4px;">
                            <span style="font-weight: 700; font-size: 0.68rem; color: var(--accent-primary); background: var(--accent-primary-glow); padding: 1px 5px; border-radius: 8px;">@demand.TargetQuantity Adet</span>
                            <button class="btn-pn primary btn-sm"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => AutoScheduleDemand(demand)"
                                    style="font-size: 0.65rem; padding: 2px 5px; display: flex; align-items: center; gap: 2px; background: linear-gradient(135deg, var(--accent-primary) 0%, #ff8c42 100%); border: none; box-shadow: 0 1px 3px rgba(244,117,43,0.15); margin-bottom: 0;"
                                    title="Otomatik zamanla">
                                <i class="bi bi-magic"></i> Akıllı
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="calendar-wrapper animate-in" style="display: block;">
        <!-- Right Side: Main Calendar Area -->
        <div class="calendar-main-area" style="padding: 1rem;">
            <!-- Calendar Toolbar -->
            <div class="calendar-toolbar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; background: var(--bg-card); padding: 0.5rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                <div class="toolbar-nav" style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                    <div class="btn-group-pn">
                        <button class="btn-pn-tab @(currentViewMode == CalendarViewMode.Week ? "active" : "")" @onclick="() => ChangeViewMode(CalendarViewMode.Week)">Hafta</button>
                        <button class="btn-pn-tab @(currentViewMode == CalendarViewMode.Month ? "active" : "")" @onclick="() => ChangeViewMode(CalendarViewMode.Month)">Ay</button>
                        <button class="btn-pn-tab @(currentViewMode == CalendarViewMode.Year ? "active" : "")" @onclick="() => ChangeViewMode(CalendarViewMode.Year)">Yıl</button>
                    </div>

                    <div style="display: flex; align-items: center; gap: 4px;">
                        <button class="btn-pn secondary icon-btn" @onclick="PreviousPeriod" title="Önceki">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn-pn secondary" @onclick="GoToToday">Bugün</button>
                        <button class="btn-pn secondary icon-btn" @onclick="NextPeriod" title="Sonraki">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.25rem;">
                        <label style="font-size: 0.8rem; opacity: 0.8; margin-bottom: 0; white-space: nowrap;">Tarihe Git:</label>
                        <input type="date" class="form-control-pn date-picker-custom" style="padding: 4px 8px; font-size: 0.8rem; width: auto;"
                               value="@currentCalendarDate.ToString("yyyy-MM-dd")"
                               @onchange="OnDatePickerChanged" />
                    </div>

                    <span class="week-label" style="font-weight: 500; font-size: 0.95rem; color: var(--text-primary);">
                        @if (currentViewMode == CalendarViewMode.Week)
                        {
                            <span>@currentMonday.Year, @(System.Globalization.ISOWeek.GetWeekOfYear(currentMonday)). Hafta: @currentMonday.ToString("dd MMM") - @currentMonday.AddDays(6).ToString("dd MMM")</span>
                        }
                        else if (currentViewMode == CalendarViewMode.Month)
                        {
                            <span>@currentCalendarDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</span>
                        }
                        else
                        {
                            <span>@currentCalendarDate.Year Yılı</span>
                        }
                    </span>
                </div>
            </div>

            @if (errorMessage != null)
            {
                <div style="padding: 0.75rem 1rem; background: var(--accent-red-glow); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.88rem; display: flex; align-items: center; justify-content: space-between;">
                     <span>@errorMessage</span>
                     <button style="background: transparent; border: none; color: inherit; cursor: pointer;" @onclick="() => errorMessage = null"><i class="bi bi-x-lg"></i></button>
                </div>
            }

            @if (successMessage != null)
            {
                <div style="padding: 0.75rem 1rem; background: rgba(16, 185, 129, 0.1); color: rgb(16, 185, 129); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.88rem; display: flex; align-items: center; justify-content: space-between;">
                     <span>@successMessage</span>
                     <button style="background: transparent; border: none; color: inherit; cursor: pointer;" @onclick="() => successMessage = null"><i class="bi bi-x-lg"></i></button>
                </div>
            }

            @if (currentViewMode == CalendarViewMode.Week)
            {
                <!-- Calendar Grid (Weekly view) -->
                <div class="calendar-scroll-container">
                    <div class="calendar-grid">
                    <!-- Header row -->
                    <div class="grid-header-cell time-col-header">Saatler</div>
                    @foreach (var day in weekDays)
                    {
                        <div class="grid-header-cell @(day.Date == DateTime.Today ? "today-header" : "")">
                            <div class="day-name">@GetTurkishDayName(day.DayOfWeek)</div>
                            <div class="day-date">@day.ToString("dd MMM")</div>
                        </div>
                    }

                    <!-- Hour rows -->
                    @for (int hour = 8; hour <= 20; hour++)
                    {
                        var currentHour = hour;
                        <div class="grid-time-cell">@($"{currentHour:00}:00")</div>

                        @foreach (DateTime day in weekDays)
                        {
                            var currentDay = day;
                            var plansInCell = GetPlansForDayAndHour(currentDay, currentHour);

                            <div class="grid-cell"
                                 @ondragover:prevent
                                 @ondrop="() => HandleDrop(currentDay, currentHour)">
                                @foreach (var plan in plansInCell)
                                {
                                    <!-- Compact Pill (Shown by default) -->
                                    <div class="plan-card-compact animate-in"
                                         style="@GetPlanCardStyle(plan)"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OpenEditModal(plan)"
                                         title="@GetPlanTooltip(plan)">
                                        <div style="display: flex; align-items: center; gap: 4px; width: 100%;">
                                            <span class="status-dot @plan.Status.ToString().ToLowerInvariant()" style="width: 5px; height: 5px; border-radius: 50%; display: inline-block; flex-shrink: 0;"></span>
                                            <span style="font-weight: 700; font-size: 0.68rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; flex: 1;">@plan.PlanCode</span>
                                        </div>
                                    </div>

                                    <!-- Detailed Card (Shown only on cell hover / drag active) -->
                                    <div class="plan-card plan-card-detailed animate-in"
                                         style="@GetPlanCardStyle(plan)"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OpenEditModal(plan)">
                                        <div class="plan-card-header">
                                            <span class="plan-code">@plan.PlanCode</span>
                                            <span class="plan-badge @plan.Status.ToString().ToLowerInvariant()">@GetPlanStatusLabel(plan.Status)</span>
                                        </div>
                                        <div class="plan-time" style="font-size: 0.72rem; opacity: 0.9; margin-top: 2px;">
                                            <i class="bi bi-calendar-event"></i> @plan.PlannedStartDate.ToString("dd.MM HH:mm") - @plan.PlannedEndDate.ToString("dd.MM HH:mm")
                                        </div>
                                        <div class="plan-estimation" style="font-size: 0.72rem; opacity: 0.95; margin-top: 4px; display: flex; flex-direction: column; gap: 2px; border-top: 1px dashed rgba(255,255,255,0.08); padding-top: 4px;">
                                            <div><i class="bi bi-hash"></i> Miktar: <strong>@plan.TargetQuantity Adet</strong></div>
                                            <div><i class="bi bi-hourglass-split"></i> Bitiş: <strong>@plan.EstimatedEndDate.ToString("dd.MM HH:mm")</strong></div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(plan.Description))
                                        {
                                            <div class="plan-desc" style="margin-top: 4px; font-size: 0.72rem;">@plan.Description</div>
                                        }
                                        <div class="plan-details" style="font-size: 0.72rem;">
                                            @if (plan.PlanProducts.Any())
                                            {
                                                <div class="detail-item">
                                                    <i class="bi bi-box-seam"></i>
                                                    <span>@string.Join(", ", plan.PlanProducts.Select(p => p.Product?.Name ?? "Ürün"))</span>
                                                </div>
                                            }
                                            @if (plan.PlanMachines.Any())
                                            {
                                                <div class="detail-item">
                                                    <i class="bi bi-gear"></i>
                                                    <span>@string.Join(", ", plan.PlanMachines.Select(m => m.Machine?.Name ?? "Makine"))</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    </div>
                </div>
            }
            else if (currentViewMode == CalendarViewMode.Month)
            {
                <!-- Monthly Grid View -->
                <div class="calendar-scroll-container">
                    <div class="month-grid-modern">
                        @foreach (var dName in new[] { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar" })
                        {
                            <div class="month-day-header">@dName</div>
                        }

                        @foreach (var day in monthDays)
                        {
                            var currentDay = day;
                            var isCurrentMonth = currentDay.Month == currentCalendarDate.Month;
                            var isToday = currentDay.Date == DateTime.Today;
                            var plansOnDay = productionPlans.Where(p => p.PlannedStartDate.Date <= currentDay.Date && p.PlannedEndDate.Date >= currentDay.Date).ToList();
                            var scheduledCount = plansOnDay.Count(p => p.Status == ProductionPlanStatus.Scheduled);
                            var inProgressCount = plansOnDay.Count(p => p.Status == ProductionPlanStatus.InProgress);
                            var awaitingCount = plansOnDay.Count(p => p.Status == ProductionPlanStatus.Awaiting);
                            var completedCount = plansOnDay.Count(p => p.Status == ProductionPlanStatus.Completed);
                            var notCompletedCount = plansOnDay.Count(p => p.Status == ProductionPlanStatus.NotCompleted);

                            <div class="month-cell-slot @(isCurrentMonth ? "" : "out-of-month") @(isToday ? "today-cell" : "")">
                                <div class="month-cell-content"
                                     @onclick="() => NavigateToWeekFromMonth(currentDay)"
                                     @ondragover:prevent
                                     @ondrop="() => HandleDrop(currentDay, 8)">
                                    <div class="month-cell-header">
                                        <span class="month-day-num @(isToday ? "today-num" : "")">@currentDay.Day</span>
                                        @if (plansOnDay.Any())
                                        {
                                            <span class="month-plan-count-badge">@plansOnDay.Count</span>
                                        }
                                    </div>
                                    <div class="month-cell-plans">
                                        @if (plansOnDay.Any())
                                        {
                                            <!-- Status dots row: compact summary -->
                                            <div class="month-status-dots">
                                                @if (scheduledCount > 0)
                                                {
                                                    <div class="month-status-chip scheduled"><span class="dot"></span>@scheduledCount</div>
                                                }
                                                @if (inProgressCount > 0)
                                                {
                                                    <div class="month-status-chip inprogress"><span class="dot"></span>@inProgressCount</div>
                                                }
                                                @if (awaitingCount > 0)
                                                {
                                                    <div class="month-status-chip awaiting"><span class="dot"></span>@awaitingCount</div>
                                                }
                                                @if (completedCount > 0)
                                                {
                                                    <div class="month-status-chip completed"><span class="dot"></span>@completedCount</div>
                                                }
                                                @if (notCompletedCount > 0)
                                                {
                                                    <div class="month-status-chip notcompleted"><span class="dot"></span>@notCompletedCount</div>
                                                }
                                            </div>

                                            <!-- Hover detail list -->
                                            <div class="month-plans-hover-list">
                                                @foreach (var plan in plansOnDay)
                                                {
                                                    <div class="month-plan-pill" style="@GetPlanCardStyle(plan)"
                                                         @onclick:stopPropagation="true"
                                                         @onclick="() => OpenEditModal(plan)"
                                                         title="@plan.PlanCode - @GetPlanStatusLabel(plan.Status)">
                                                        <span class="pill-dot" style="background: hsla(var(--plan-hue, 200), 65%, 55%, 1);"></span>
                                                        <span class="pill-code">@plan.PlanCode</span>
                                                        <span class="pill-product">@(plan.PlanProducts.FirstOrDefault()?.Product?.Name ?? "Ürün")</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (currentViewMode == CalendarViewMode.Year)
            {
                <!-- Yearly Grid View -->
                <div class="year-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthVal = m;
                        var monthName = new DateTime(currentCalendarDate.Year, monthVal, 1).ToString("MMMM", new System.Globalization.CultureInfo("tr-TR"));
                        var monthPlans = productionPlans.Where(p => p.PlannedStartDate.Year == currentCalendarDate.Year && (p.PlannedStartDate.Month == monthVal || p.PlannedEndDate.Month == monthVal)).ToList();

                        <div class="year-card"
                             @onclick="() => NavigateToMonthFromYear(monthVal)"
                             style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: var(--radius-md); transition: all 0.2s ease; cursor: pointer; display: flex; flex-direction: column; gap: 0.75rem;">
                            <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; text-transform: capitalize;">@monthName</div>

                            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-size: 0.8rem;">
                                <div style="padding: 6px; background: rgba(59, 130, 246, 0.05); border-radius: var(--radius-sm); text-align: center;">
                                    <div style="color: var(--accent-blue); font-weight: 700;">@monthPlans.Count(p => p.Status == ProductionPlanStatus.Scheduled)</div>
                                    <div style="opacity: 0.7; font-size: 0.7rem;">Planlandı</div>
                                </div>
                                <div style="padding: 6px; background: rgba(244, 117, 43, 0.05); border-radius: var(--radius-sm); text-align: center;">
                                    <div style="color: var(--accent-primary); font-weight: 700;">@monthPlans.Count(p => p.Status == ProductionPlanStatus.InProgress)</div>
                                    <div style="opacity: 0.7; font-size: 0.7rem;">Üretimde</div>
                                </div>
                                <div style="padding: 6px; background: rgba(234, 179, 8, 0.05); border-radius: var(--radius-sm); text-align: center;">
                                    <div style="color: rgb(234, 179, 8); font-weight: 700;">@monthPlans.Count(p => p.Status == ProductionPlanStatus.Awaiting)</div>
                                    <div style="opacity: 0.7; font-size: 0.7rem;">Bekleniyor</div>
                                </div>
                                <div style="padding: 6px; background: rgba(16, 185, 129, 0.05); border-radius: var(--radius-sm); text-align: center;">
                                    <div style="color: rgb(16, 185, 129); font-weight: 700;">@monthPlans.Count(p => p.Status == ProductionPlanStatus.Completed)</div>
                                    <div style="opacity: 0.7; font-size: 0.7rem;">Tamamlandı</div>
                                </div>
                                <div style="padding: 6px; background: rgba(239, 68, 68, 0.05); border-radius: var(--radius-sm); text-align: center; grid-column: span 2;">
                                    <div style="color: var(--accent-red); font-weight: 700;">@monthPlans.Count(p => p.Status == ProductionPlanStatus.NotCompleted)</div>
                                    <div style="opacity: 0.7; font-size: 0.7rem;">Tamamlanamadı</div>
                                </div>
                            </div>

                            <div style="font-size: 0.75rem; text-align: right; opacity: 0.6; margin-top: 4px;">Toplam Plan: <strong>@monthPlans.Count</strong></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- MODAL -->
@if (showModal)
{
    <div class="modal-overlay" @onmousedown="() => isMouseDownOnOverlay = true" @onmouseup="HandleOverlayMouseUp">
        <div class="modal-content-pn" @onmousedown:stopPropagation="true" @onmouseup:stopPropagation="true" style="max-width: 600px;">
            <div class="modal-header-pn">
                <h3>@(isCreatingDemand ? "Yeni Üretim Talebi Oluştur" : isEditingDemand ? "Talebi Düzenle" : isPlanningFromDemand ? "Yeni Plan Oluştur (Talepten)" : "Planı Düzenle")</h3>
                <button class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem; text-align: left;">
                @if (isCreatingDemand || isEditingDemand)
                {
                    <div class="grid-2">
                        <div>
                            <label class="form-label-pn">Talep Kodu</label>
                            <input type="text" class="form-control-pn" @bind="planCode" placeholder="Örn: DEM-001" />
                        </div>
                        <div>
                            <label class="form-label-pn">Hedef Miktar (Adet)</label>
                            <input type="number" class="form-control-pn" @bind="targetQuantity" min="1" placeholder="Örn: 1000" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label-pn">Ürün Seçimi</label>
                        <select class="form-control-pn" @bind="selectedDemandProductId">
                            <option value="0">-- Ürün Seçin --</option>
                            @foreach (var prod in productsList)
                            {
                                <option value="@prod.Id">@prod.Name</option>
                            }
                        </select>
                    </div>



                    <div>
                        <label class="form-label-pn">Açıklama / Notlar</label>
                        <input type="text" class="form-control-pn" @bind="description" placeholder="Talep notları..." />
                    </div>
                }
                else
                {
                    <div>
                        <label class="form-label-pn">Plan Kodu</label>
                        <input type="text" class="form-control-pn" @bind="planCode" placeholder="Örn: PLN-001" />
                    </div>

                    <div>
                        <label class="form-label-pn">Açıklama / Notlar</label>
                        <input type="text" class="form-control-pn" @bind="description" placeholder="Plan notları..." />
                    </div>

                    <div style="padding: 0.75rem; background: var(--accent-primary-glow); border: 1px solid rgba(244, 117, 43, 0.2); border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--text-primary);">
                        <i class="bi bi-info-circle-fill" style="color: var(--accent-primary); margin-right: 6px;"></i>
                        Seçilen makinelerin saatlik toplam üretim kapasitesine göre planlanacak miktar: <strong>@GetCalculatedCapacity() Adet</strong>
                        @if (isPlanningFromDemand && draggedDemandPlan != null && GetCalculatedCapacity() >= draggedDemandPlan.TargetQuantity)
                        {
                            <span style="display: block; font-size: 0.75rem; opacity: 0.8; margin-top: 4px;">(Kalan talep miktarının tamamı karşılanmaktadır)</span>
                        }
                    </div>

                    <div class="grid-2">
                        <div>
                            @if (isPlanningFromDemand)
                            {
                                <label class="form-label-pn">Planlanacak Ürün</label>
                                <div style="padding: 0.5rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600;">
                                    @(productsList.FirstOrDefault(p => selectedProductIds.Contains(p.Id))?.Name ?? "Bilinmeyen Ürün")
                                </div>
                            }
                            else
                            {
                                <label class="form-label-pn">Ürün Seçimi (Çoklu)</label>
                                <div style="display: flex; flex-direction: column; gap: 6px; max-height: 150px; overflow-y: auto; padding: 0.5rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                                    @foreach (var prod in productsList)
                                    {
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <input type="checkbox" id="prod-@prod.Id"
                                                   checked="@(selectedProductIds.Contains(prod.Id))"
                                                   @onchange="@(e => ToggleProductSelection(prod.Id, (bool)e.Value!))" />
                                            <label for="prod-@prod.Id" style="font-size: 0.85rem; cursor: pointer; margin-bottom: 0; user-select: none;">@prod.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div>
                            <label class="form-label-pn">Makine Seçimi (Çoklu)</label>
                            <div style="display: flex; flex-direction: column; gap: 6px; max-height: 150px; overflow-y: auto; padding: 0.5rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                                @foreach (var mach in machinesList)
                                {
                                    var isBusy = IsMachineBusy(mach.Id);
                                    <div style="display: flex; align-items: center; gap: 8px; opacity: @(isBusy ? "0.55" : "1");">
                                        <input type="checkbox" id="mach-@mach.Id"
                                               checked="@(selectedMachineIds.Contains(mach.Id))"
                                               disabled="@isBusy"
                                               @onchange="@(e => ToggleMachineSelection(mach.Id, (bool)e.Value!))" />
                                        <label for="mach-@mach.Id" style="font-size: 0.85rem; cursor: pointer; margin-bottom: 0; user-select: none; text-decoration: @(isBusy ? "line-through" : "none");" title="@(isBusy ? "Bu makine bu saatte başka plana atanmış" : "")">
                                            @mach.Name @(isBusy ? " (Meşgul)" : "")
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (isEditing)
                        {
                            <div style="margin-top: 1rem; grid-column: span 2;">
                                <label class="form-label-pn">Plan Durumu</label>
                                <select class="form-control-pn" @bind="planStatus" style="width: 100%; padding: 0.4rem 0.75rem; background: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary);">
                                    <option value="@ProductionPlanStatus.Scheduled">Planlandı</option>
                                    <option value="@ProductionPlanStatus.InProgress">Üretimde</option>
                                    <option value="@ProductionPlanStatus.Awaiting">Bekleniyor</option>
                                    <option value="@ProductionPlanStatus.Completed">Tamamlandı</option>
                                    <option value="@ProductionPlanStatus.NotCompleted">Tamamlanamadı</option>
                                </select>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-actions" style="margin-top: 1.5rem;">
                @if (isEditing || isEditingDemand)
                {
                    <button class="btn-pn danger" @onclick="DeletePlan" style="margin-right: auto;">@(isEditingDemand ? "Talebi Sil" : "Planı Sil")</button>
                }
                <button class="btn-pn secondary" @onclick="CloseModal">İptal</button>
                <button class="btn-pn primary" @onclick="SavePlan" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                    }
                    <span>Kaydet</span>
                </button>
            </div>
        </div>
    </div>
}

