    private int GetHourlyCapacityForMachine(Machine machine, Product product)
    {
        double capacity = 0;
        if (machine is CoilWindingMachine cwm)
        {
            var originalProduct = cwm.CurrentProduct;
            cwm.CurrentProduct = product;
            var speed = cwm.CalculateOptimalSpeed(SpeedStrategyFactory);
            cwm.CurrentProduct = originalProduct;
            capacity = speed > 0 ? speed * 60 : 50;
        }
        else
        {
            capacity = 30;
        }
        return (int)capacity;
    }

    private async Task AutoScheduleDemand(ProductionPlan demand)
    {
        var product = demand.PlanProducts.FirstOrDefault()?.Product;
        if (product == null)
        {
            errorMessage = "Talebe ait ürün bulunamadı.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            int remainingQty = demand.TargetQuantity;
            var now = DateTime.Now;
            var searchTime = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0).AddHours(1);

            int safetyCounter = 0;
            var createdPlansCount = 0;
            var placementDetails = new List<string>();

            // Load fresh plans from DB to prevent overlapping
            var allPlans = await ProductionPlanService.GetAllProductionPlansAsync();
            var activePlans = allPlans.Where(p => p.Status != ProductionPlanStatus.Demand).ToList();

            while (remainingQty > 0 && safetyCounter < 720) // Search up to 30 days
            {
                var slotStart = searchTime;
                var slotEnd = searchTime.AddHours(1);

                // Find busy machines in this 1-hour slot
                var plansInSlot = activePlans
                    .Where(p => p.PlannedStartDate < slotEnd && p.PlannedEndDate > slotStart)
                    .ToList();

                var busyMachineIds = plansInSlot
                    .SelectMany(p => p.PlanMachines.Select(pm => pm.Machine?.Id))
                    .Where(id => id.HasValue)
                    .Select(id => id!.Value)
                    .ToHashSet();

                // Find free machines in this slot that are not in maintenance/malfunction
                var freeMachines = machinesList
                    .Where(m => !busyMachineIds.Contains(m.Id) && m.Status != MachineStatus.Maintenance && m.Status != MachineStatus.Malfunction)
                    .ToList();

                if (freeMachines.Any())
                {
                    foreach (var machine in freeMachines)
                    {
                        if (remainingQty <= 0) break;

                        int hourlyCapacity = GetHourlyCapacityForMachine(machine, product);
                        int planQty = Math.Min(remainingQty, hourlyCapacity);

                        var plan = new ProductionPlan
                        {
                            PlanCode = $"PLN-{demand.PlanCode.Replace("DEM-", "")}-{searchTime:yyyyMMddHH}",
                            Description = $"Otomatik akıllı zamanlama ({demand.PlanCode})",
                            PlannedStartDate = slotStart,
                            PlannedEndDate = slotEnd,
                            Status = ProductionPlanStatus.Scheduled,
                            TargetQuantity = planQty,
                            CreatedDate = DateTime.Now,
                            UpdatedDate = DateTime.Now
                        };

                        plan.PlanProducts.Add(new ProductionPlanProduct
                        {
                            Product = product,
                            CreatedDate = DateTime.Now,
                            UpdatedDate = DateTime.Now
                        });

                        plan.PlanMachines.Add(new ProductionPlanMachine
                        {
                            Machine = machine,
                            CreatedDate = DateTime.Now,
                            UpdatedDate = DateTime.Now
                        });

                        await ProductionPlanService.SaveProductionPlanAsync(plan);
                        
                        // Add to our list of active plans in-memory so next iterations of the loop know this machine is now busy
                        activePlans.Add(plan);

                        placementDetails.Add($"{slotStart:dd.MM.yyyy HH:00} ({machine.Name})");
                        remainingQty -= planQty;
                        createdPlansCount++;
                    }
                }

                searchTime = searchTime.AddHours(1);
                safetyCounter++;
            }

            if (remainingQty > 0)
            {
                errorMessage = $"Talep kısmen planlanabildi. Kalan miktar: {remainingQty} Adet. Lütfen kapasiteyi veya makineleri kontrol edin.";
            }

            if (placementDetails.Any())
            {
                successMessage = $"'{demand.PlanCode}' kodlu talep başarıyla zamanlandı! Atanan slotlar: {string.Join(", ", placementDetails)}";
            }

            // Remove the original demand if it is fully planned, or update its target quantity if partially planned!
            if (remainingQty <= 0)
            {
                await ProductionPlanService.DeleteProductionPlanAsync(demand.Id);
            }
            else
            {
                demand.TargetQuantity = remainingQty;
                await ProductionPlanService.SaveProductionPlanAsync(demand);
            }

            // Refresh the screen
            await LoadData();
            StateHasChanged();
            
            // Notify other users/circuits
            PlanEventService.NotifyPlanStatusChanged(0);
        }
        catch (Exception ex)
        {
            errorMessage = $"Otomatik planlama sırasında hata oluştu: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandlePlanStatusChanged(int planId)
    {
        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        PlanEventService.OnPlanStatusChanged -= HandlePlanStatusChanged;
    }
}