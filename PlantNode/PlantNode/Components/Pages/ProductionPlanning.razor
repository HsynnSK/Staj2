    private int GetCalculatedCapacity()
    {
        var productId = selectedProductIds.FirstOrDefault();
        if (productId == 0) return 0;
        var product = productsList.FirstOrDefault(p => p.Id == productId);
        if (product == null) return 0;

        double totalCapacity = 0;
        foreach (var machineId in selectedMachineIds)
        {
            var mach = machinesList.FirstOrDefault(m => m.Id == machineId);
            if (mach != null)
            {
                double machineCapacity = 0;
                if (mach is CoilWindingMachine cwm)
                {
                    var originalProduct = cwm.CurrentProduct;
                    cwm.CurrentProduct = product;
                    var speed = cwm.CalculateOptimalSpeed(SpeedStrategyFactory);
                    cwm.CurrentProduct = originalProduct; // restore
                    machineCapacity = speed > 0 ? (speed * 60) : 50;
                }
                else
                {
                    machineCapacity = 30; // standard fallback
                }
                totalCapacity += machineCapacity;
            }
        }

        int finalQuantity = (int)totalCapacity;
        if (finalQuantity <= 0) finalQuantity = 1;

        if (isPlanningFromDemand && draggedDemandPlan != null)
        {
            finalQuantity = Math.Min(finalQuantity, draggedDemandPlan.TargetQuantity);
        }

        return finalQuantity;
    }

