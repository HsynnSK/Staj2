    private void SyncCalendarState()
    {
        weekDays.Clear();
        int diff = (7 + (currentCalendarDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        currentMonday = currentCalendarDate.AddDays(-1 * diff).Date;
        for (int i = 0; i < 7; i++)
        {
            weekDays.Add(currentMonday.AddDays(i));
        }

        monthDays.Clear();
        var firstDayOfMonth = new DateTime(currentCalendarDate.Year, currentCalendarDate.Month, 1);
        int offset = (7 + (firstDayOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
        var gridStart = firstDayOfMonth.AddDays(-offset);
        for (int i = 0; i < 42; i++)
        {
            monthDays.Add(gridStart.AddDays(i));
        }
    }

