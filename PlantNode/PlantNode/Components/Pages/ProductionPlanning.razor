    private void PreviousPeriod()
    {
        if (currentViewMode == CalendarViewMode.Week)
            currentCalendarDate = currentCalendarDate.AddDays(-7);
        else if (currentViewMode == CalendarViewMode.Month)
            currentCalendarDate = currentCalendarDate.AddMonths(-1);
        else
            currentCalendarDate = currentCalendarDate.AddYears(-1);

        SyncCalendarState();
