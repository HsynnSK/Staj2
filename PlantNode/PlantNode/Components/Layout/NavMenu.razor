<div class="nav-menu-wrapper @(IsCollapsed ? "collapsed" : "")">
    <div class="sidebar-header">
        @if (!IsCollapsed)
        {
            <div class="sidebar-brand animate-fade-in">
                <i class="bi bi-cpu"></i>
                <span class="brand-text">PlantNode</span>
            </div>
        }
        else
        {
            <div class="sidebar-brand-collapsed">
                <i class="bi bi-cpu"></i>
            </div>
        }
        <button class="sidebar-toggle-btn" @onclick="OnToggle" title="Menüyü Daralt/Genişlet">
            <i class="bi bi-list"></i>
        </button>
    </div>

    <nav class="sidebar-nav">
        @if (!IsCollapsed)
        {
            <div class="nav-section-label animate-fade-in">Ana Menü</div>
        }
        
        <NavLink class="nav-link-pn" href="" Match="NavLinkMatch.All" title="Ana Sayfa">
            <i class="bi bi-house-door"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Ana Sayfa</span>
            }
        </NavLink>

        <NavLink class="nav-link-pn" href="plants" title="Tesisler">
            <i class="bi bi-building"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Tesisler</span>
            }
        </NavLink>

        <NavLink class="nav-link-pn" href="machines" title="Makineler">
            <i class="bi bi-gear-wide-connected"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Makineler</span>
            }
        </NavLink>

        <NavLink class="nav-link-pn" href="products" title="Ürünler">
            <i class="bi bi-box-seam"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Ürünler</span>
            }
        </NavLink>

        @if (!IsCollapsed)
        {
            <div class="nav-section-label animate-fade-in">Operasyonlar</div>
        }
        
        <NavLink class="nav-link-pn" href="maintenance" title="Bakım Takvimi">
            <i class="bi bi-calendar-check"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Bakım Takvimi</span>
            }
        </NavLink>

        <NavLink class="nav-link-pn" href="production-planning" title="Üretim Planlama">
            <i class="bi bi-calendar-range"></i>
            @if (!IsCollapsed)
            {
                <span class="animate-fade-in">Üretim Planlama</span>
            }
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        @if (!IsCollapsed)
        {
            <div class="version-info animate-fade-in">
                <i class="bi bi-shield-check"></i>
                <span>v1.0.0</span>
            </div>
        }
        else
        {
            <div class="version-info-collapsed" title="v1.0.0">
                <i class="bi bi-shield-check"></i>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }
}
